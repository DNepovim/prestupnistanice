---
import { Image } from 'astro:assets'
import { getEntries, getEntry } from 'astro:content'

import Theme from '@/components/Theme.astro'
import { routes } from '@/routes'
import { getSlugFromPath } from '@/utils/getSlugFromPath'
import { tp } from '@/utils/tp'

import FloatingImage from './FloatingImage.svelte'

type Props = {
  slug: string
}

const { slug } = Astro.props

const entry = await getEntry('book', slug)

if (!entry) {
  return
}

const { data: b } = entry

const link = routes.books.detail(slug)

const authors = await getEntries(
  b.authors.filter((a) => a.isMain).map(({ slug }) => slug),
)
---

<Theme firstColor={b.color} secondColor={b.bgColor}>
  <article class="jus flex w-64 justify-end gap-4 min-md:mb-12">
    {
      (
        <a href={link} class="width-8 block shrink-0">
          <Image
            alt={b.title}
            src={b.cover}
            width={157.5}
            height={225}
            class="w-24 -rotate-2 rounded-md border border-gray-200 shadow-2xl"
          />
        </a>
      )
    }

    <div class="flex-1">
      <h2 class="group font-alt text-brand-first-500 text-xl">
        <a class="relative" href={link}
          >{tp(b.title)}
          <span
            class="bg-brand-first-500 absolute bottom-0 left-0 h-[1px] w-0 transition-all duration-600 group-hover:w-full"
          ></span>
        </a>
      </h2>
      <div class="text-gray-500">
        {
          authors.map((a, index) => (
            <>
              {index !== 0 ? ', ' : ''}
              <FloatingImage
                client:visible
                src={a.data.image?.src}
                alt={`${a.data.firstname} ${a.data.surname}`}
              >
                <a
                  class="group font-alt whitespace-nowrap transition-colors hover:text-black"
                  href={routes.authors.detail(getSlugFromPath(a.data.slug))}
                >
                  {a.data.firstname} {a.data.surname}
                </a>
              </FloatingImage>
            </>
          ))
        }
      </div>
    </div>
  </article></Theme
>
