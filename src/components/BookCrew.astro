---
import type { ImageMetadata } from 'astro'
import { Icon } from 'astro-icon/components'
import { isNonEmptyArray, isNonEmptyString } from 'narrowland'

import Portrait from '@/components/Portrait.astro'
import Tooltip from '@/components/Tooltip.astro'
import { routes } from '@/routes'

type Props = {
  people: {
    slug: string
    name: string
    image?: ImageMetadata
    roles: string
    col?: string
  }[]
}

const { people } = Astro.props
---

{
  isNonEmptyArray(people) && (
    <div>
      <ol class="flex flex-col gap-5">
        {people.map((person) => (
          <li class="group group/person flex items-center gap-4">
            <div class="after:border-brand-first-500 relative shrink-0 after:absolute after:top-full after:left-1/2 after:h-5 after:border-l group-last:after:hidden">
              <Portrait image={person.image} size={80} revealOnHover class="w-10" />
            </div>
            <div class="min-w-0">
              <p class="font-alt text-brand-first-700 text-[0.85rem] leading-none tracking-[0.04em]">
                {person.roles}
              </p>
              <p class="mt-1 inline-flex items-center gap-2 text-[1rem] leading-tight">
                <a href={routes.authors.detail(person.slug)}>{person.name}</a>
                {isNonEmptyString(person.col) && (
                  <Tooltip label={person.col}>
                    <Icon name="ph:info" class="text-brand-first-700 size-4" />
                  </Tooltip>
                )}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  )
}
