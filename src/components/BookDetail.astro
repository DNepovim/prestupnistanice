---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { getCollection, getEntry } from 'astro:content'
import { isDefined, isNonEmptyArray } from 'narrowland'

import ArrowLink from '@/components/ArrowLink.astro'
import BookAuthor from '@/components/BookAuthor.astro'
import BookBgAlphaControl from '@/components/BookBgAlphaControl.svelte'
import BookBuy from '@/components/BookBuy.svelte'
import BookCrew from '@/components/BookCrew.astro'
import BookGallery from '@/components/BookGallery.astro'
import BookMeta from '@/components/BookMeta.astro'
import BookReviews from '@/components/BookReviews.astro'
import BookSample from '@/components/BookSample.astro'
import BooksContactSheet from '@/components/BooksContactSheet.astro'
import BooksIndex from '@/components/BooksIndex.astro'
import CmykBar from '@/components/CmykBar.astro'
import ColorBar from '@/components/ColorBar.astro'
import FloatingImage from '@/components/FloatingImage.svelte'
import HeroNeighbour from '@/components/HeroNeighbour.astro'
import Markdown from '@/components/Markdown.astro'
import PrintSheet from '@/components/PrintSheet.astro'
import { FALLBACK_COLOR_FIRST, FALLBACK_COLOR_SECOND } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { CATEGORIES, routes } from '@/routes'
import { getAuthorsSecondName } from '@/utils/getAuthorSecondName'
import { getSheetEdge } from '@/utils/getSheetEdge'
import { joinWords } from '@/utils/joinWords'
import { ROLE_ORDER, rolesMap } from '@/utils/rolesMap'
import { getTitleFit } from '@/utils/titleFit'
import { tp } from '@/utils/tp'

type Props = {
  slug: string
}

type SheetKey = 'hero' | 'text' | 'sample' | 'gallery' | 'meta' | 'author' | 'category'
type Category = CollectionEntry<'book'>['data']['category']
type Role = CollectionEntry<'book'>['data']['authors'][number]['role'][number]
type Contributor = { slug: string; isMain: boolean; col?: string; roles: Role[] }

const getCategoryLabel = (category: Category) =>
  CATEGORIES[category].name.charAt(0).toUpperCase() + CATEGORIES[category].name.slice(1)

const NON_PRINTING_MARK =
  'font-alt text-brand-first-700/45 align-baseline font-normal select-none'

const { slug } = Astro.props

const entry = await getEntry('book', slug)

if (!entry) {
  return
}

const { data: book } = entry

const contributors = Object.values(
  book.authors.reduce<Record<string, Contributor>>((acc, a) => {
    const existing = acc[a.slug.id]
    return {
      ...acc,
      [a.slug.id]: {
        slug: a.slug.id,
        isMain: existing?.isMain === true || a.isMain === true,
        col: existing?.col ?? a.col,
        roles: [...new Set([...(existing?.roles ?? []), ...a.role])],
      },
    }
  }, {}),
)

const mainContributors = contributors.filter((c) => c.isMain)

const mainAuthors = (
  await Promise.all(mainContributors.map(async (c) => getEntry('author', c.slug)))
).filter(isDefined)

const mainAuthorsWithRoles = mainAuthors.map((a) => ({
  author: a,
  roles: mainContributors.find((c) => c.slug === a.id)?.roles ?? [],
}))

const mainAuthorSlug = book.authors.find((a) => a.isMain && a.role.includes('author'))
  ?.slug.id

const mainAuthor = mainAuthorSlug ? await getEntry('author', mainAuthorSlug) : undefined

const authorsBooks = mainAuthorSlug
  ? await getCollection(
      'book',
      (b) =>
        b.data.slug !== slug &&
        b.data.authors.filter((a) => a.isMain).some((a) => a.slug.id === mainAuthorSlug),
    )
  : []

const categoryBooks = await getCollection(
  'book',
  (b) => b.data.slug !== slug && b.data.category === book.category,
)

const otherCategoryBooks = categoryBooks.filter(
  (b) => !authorsBooks.some((a) => a.data.slug === b.data.slug),
)

const reviews = (await getCollection('review', (r) => r.data.book === slug)).toSorted(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
)

const getFullName = (a: CollectionEntry<'author'>['data']) =>
  `${a.firstname} ${a.surname}`

const people = (
  await Promise.all(
    contributors
      .filter((c) => !c.isMain)
      .map(async (a) => {
        const person = await getEntry('author', a.slug)
        if (!person) {
          return undefined
        }
        const roles = ROLE_ORDER.filter((role) => a.roles.includes(role))
        return {
          slug: a.slug,
          name: getFullName(person.data),
          image: person.data.image,
          roles: joinWords(
            roles
              .map((role) => rolesMap[role]?.perfect[person.data.gender])
              .filter(isDefined),
          ),
          col: a.col,
          order: Math.min(...roles.map((role) => ROLE_ORDER.indexOf(role))),
        }
      }),
  )
)
  .filter(isDefined)
  .toSorted((a, b) => a.order - b.order)

const asideCover = book.coverImage ?? book.cover

const galleryModules = import.meta.glob<ImageMetadata>(
  '/src/content/images/books/*/gallery/*.{jpg,jpeg,png,webp}',
  { eager: true, import: 'default' },
)

const galleryImages = Object.entries(galleryModules)
  .filter(([path]) => path.includes(`/books/${slug}/gallery/`))
  .toSorted(([a], [b]) => a.localeCompare(b, 'cs', { numeric: true }))
  .map(([, image]) => image)

const samplePages = book.samplePages ?? []

const hasMeta = [
  book.date,
  book.pagesCount,
  book.width && book.height,
  book.paper,
  book.font,
  book.isbn,
].some(Boolean)

const candidateSheetKeys: (SheetKey | undefined)[] = [
  book.coverTop ? 'hero' : undefined,
  'text',
  isNonEmptyArray(samplePages) ? 'sample' : undefined,
  isNonEmptyArray(galleryImages) ? 'gallery' : undefined,
  hasMeta || isNonEmptyArray(people) ? 'meta' : undefined,
  mainAuthor && isNonEmptyArray(authorsBooks) ? 'author' : undefined,
  isNonEmptyArray(otherCategoryBooks) ? 'category' : undefined,
]

const sheetKeys = candidateSheetKeys.filter(isDefined)

const getEdge = (key: SheetKey) =>
  getSheetEdge(sheetKeys.indexOf(key), sheetKeys.length)

const titleFit = getTitleFit(tp(book.title))

const getSeparator = (index: number, total: number) => {
  if (index === 0) {
    return ''
  }
  return index === total - 1 ? ' a ' : ', '
}

const authorsLine = joinWords(mainAuthors.map((a) => getFullName(a.data)))

const orderedTitle = `${String(book.order)}. ${book.title}`

const fileSlug = authorsLine ? `${orderedTitle} · ${authorsLine}` : orderedTitle

const dimensions =
  book.width && book.height ? `${String(book.width)} × ${String(book.height)} mm` : ''

const orderedBooks = (await getCollection('book')).toSorted(
  (a, b) => a.data.order - b.data.order,
)

const bookIndex = orderedBooks.findIndex((b) => b.data.slug === slug)

const getNeighbourSlug = async (neighbour: CollectionEntry<'book'> | undefined) => {
  if (!neighbour) {
    return undefined
  }
  const neighbourAuthors = (
    await Promise.all(
      neighbour.data.authors
        .filter((a) => a.isMain)
        .map(async (a) => getEntry('author', a.slug.id)),
    )
  ).filter(isDefined)
  const neighbourAuthorsLine = joinWords(neighbourAuthors.map((a) => getFullName(a.data)))
  const neighbourOrderedTitle = `${String(neighbour.data.order)}. ${neighbour.data.title}`
  return neighbourAuthorsLine
    ? `${neighbourOrderedTitle} · ${neighbourAuthorsLine}`
    : neighbourOrderedTitle
}

const prevBook = bookIndex > 0 ? orderedBooks[bookIndex - 1] : undefined
const nextBook = bookIndex >= 0 ? orderedBooks[bookIndex + 1] : undefined

const prevSlug = await getNeighbourSlug(prevBook)
const nextSlug = await getNeighbourSlug(nextBook)

const sideSlug = [
  String(book.date),
  book.pagesCount ? `${String(book.pagesCount)} stran` : '',
  dimensions,
  book.paper ? `papír ${book.paper}` : '',
  book.font ? `písmo ${book.font}` : '',
  book.isbn ? `ISBN ${book.isbn}` : '',
]
  .filter((part) => part !== '')
  .join(' · ')
---

<Layout
  keepHue
  tintedHeader
  tintedBackground
  siteTitle={book.title}
  siteDescription={book.claim ?? ''}
  firstColor={book.color}
  secondColor={book.bgColor}
>
  <div class="overflow-x-clip pt-4 [view-transition-name:book-sheets]">
    {
      book.coverTop && (
        <PrintSheet edge={getEdge('hero')} regs={['t']} slug={fileSlug} cutAtBottom>
          <div class="relative aspect-[5/2] w-full">
            <Image
              alt=""
              src={book.coverTop}
              width={2400}
              widths={[1024, 1600, 2400]}
              sizes="(min-width: 72rem) 62rem, 100vw"
              loading="eager"
              class="absolute -inset-[3mm] size-[calc(100%+6mm)] max-w-none object-cover"
            />
          </div>
          <ColorBar
            variant="wave"
            from={book.color ?? FALLBACK_COLOR_FIRST}
            to={book.bgColor ?? FALLBACK_COLOR_SECOND}
            class="absolute top-[calc(100%+3mm+0.5rem)] left-0"
          />
          <CmykBar variant="wave" class="absolute top-[calc(100%+3mm+0.5rem)] right-0" />
          <HeroNeighbour side="prev" book={prevBook} slug={prevSlug} />
          <HeroNeighbour side="next" book={nextBook} slug={nextSlug} />
        </PrintSheet>
      )
    }
    <PrintSheet
      edge={getEdge('text')}
      regs={['r']}
      slug={book.coverTop ? undefined : fileSlug}
      sideSlug={sideSlug}
      revealSideSlugOnScroll={!book.coverTop}
    >
      {
        !book.coverTop && (
          <>
            <HeroNeighbour side="prev" book={prevBook} slug={prevSlug} />
            <HeroNeighbour side="next" book={nextBook} slug={nextSlug} />
          </>
        )
      }
      <div
        class="relative grid grid-cols-[minmax(0,1fr)] gap-x-[2.6rem] px-[0.9rem] py-[2.2rem] min-md:grid-cols-[minmax(0,1fr)_10rem] min-md:px-[2.6rem] min-md:py-[2.5rem] min-lg:grid-cols-[minmax(0,1fr)_15.5rem]"
      >
        {
          book.coverTop && (
            <div
              aria-hidden="true"
              data-stick-sentinel
              class="pointer-events-none absolute top-[2.5rem] left-0 h-px w-px"
            />
          )
        }
        <header class="[container-type:inline-size] min-md:col-start-1">
          <p
            class="font-alt text-brand-first-700 mb-[1.3rem] text-[0.7rem] leading-[1.2] tracking-[0.1em] uppercase"
          >
            {getCategoryLabel(book.category)}
          </p>
          <h1
            style={`--title-w:${titleFit.widthEm.toFixed(3)}`}
            class="font-head text-brand-first-500 [font-size:min(8rem,calc(100cqw/var(--title-w)))] leading-[1.04] font-extrabold tracking-[-0.02em]"
          >
            {
              titleFit.lines.map((line, index) => (
                <span class="block whitespace-nowrap">
                  {line}
                  {index === titleFit.lines.length - 1 && (
                    <span
                      aria-hidden="true"
                      class:list={[NON_PRINTING_MARK, 'ml-[0.25em] text-[0.3em]']}
                    >
                      ↵
                    </span>
                  )}
                </span>
              ))
            }
          </h1>
          {
            authorsLine && (
              <div class="font-alt mt-2 text-[1.2rem] leading-[1.2] text-gray-800 italic min-md:text-[1.4rem] min-lg:text-[1.6rem]">
                {mainAuthors.map(({ data: a }, index) => (
                  <>
                    {getSeparator(index, mainAuthors.length)}
                    <FloatingImage client:visible src={a.image?.src} alt={getFullName(a)}>
                      <a
                        class="transition-colors hover:text-black"
                        href={routes.authors.detail(a.slug)}
                      >
                        {getFullName(a)}
                      </a>
                    </FloatingImage>
                  </>
                ))}
              </div>
            )
          }
        </header>
        <aside
          class="min-md:animate-sticky-ease flex flex-col items-start max-md:my-6 min-md:sticky min-md:top-6 min-md:col-start-2 min-md:row-span-6 min-md:row-start-1 min-md:self-start min-md:pt-[1.7rem]"
        >
          <div
            data-reveal-on-stick={book.coverTop ? '' : undefined}
            class:list={[
              'grid w-full max-w-[16rem] grid-cols-[minmax(0,1fr)] grid-rows-[1fr]',
              book.coverTop
                ? 'min-md:grid-rows-[0fr] min-md:opacity-0 min-md:transition-[grid-template-rows,opacity] min-md:duration-500 min-md:ease-out min-md:data-stuck:grid-rows-[1fr] min-md:data-stuck:opacity-100 min-md:motion-reduce:transition-none'
                : '',
            ]}
          >
            <div class="min-h-0 min-w-0 overflow-y-clip">
              <div class="pb-7">
                <Image
                  alt={book.title}
                  src={asideCover}
                  width={560}
                  loading="eager"
                  style={`aspect-ratio:${String(asideCover.width)}/${String(asideCover.height)}`}
                  class="h-auto w-full shadow-[0_0.3rem_1.4rem_rgba(0,0,0,0.18)]"
                />
                {
                  !book.coverTop && (
                    <ColorBar
                      variant="wave"
                      from={book.color ?? FALLBACK_COLOR_FIRST}
                      to={book.bgColor ?? FALLBACK_COLOR_SECOND}
                      class="mt-4"
                    />
                  )
                }
              </div>
            </div>
          </div>
          <BookBuy
            client:load
            slug={book.slug}
            title={book.title}
            kosmasUrl={book.kosmasUrl}
            price={book.price}
            isUpcoming={book.isUpcoming}
            releaseNote={book.releaseNote}
          />
        </aside>
        <div class="mt-[1.4rem] min-md:col-start-1">
          {
            book.claim && (
              <blockquote class="font-alt first-letter:text-brand-first-500 mb-8 text-[1rem] leading-[1.45] text-gray-800 italic first-letter:float-left first-letter:pt-[0.06em] first-letter:pr-[0.1em] first-letter:text-[3.1em] first-letter:leading-[0.82] first-letter:font-bold min-lg:text-[1.15rem]">
                {tp(book.claim)}
                <span
                  aria-hidden="true"
                  class:list={[NON_PRINTING_MARK, 'ml-1.5 text-[0.6em]']}
                >
                  ¶
                </span>
              </blockquote>
            )
          }
          {entry.body && <Markdown showMarks class="text-[1rem]" text={entry.body} />}
        </div>
        {
          isNonEmptyArray(mainAuthorsWithRoles) && (
            <div class="mt-10 flex flex-col gap-8 min-md:col-start-1">
              {mainAuthorsWithRoles.map(({ author, roles }) => (
                <BookAuthor slug={author.data.slug} roles={roles} />
              ))}
            </div>
          )
        }
        {
          isNonEmptyArray(reviews) && (
            <div class="mt-12 min-md:col-start-1">
              <p class="font-alt text-brand-first-700 mb-8 text-[0.7rem] leading-none tracking-[0.1em] uppercase">
                Recenze
              </p>
              <BookReviews reviews={reviews} />
            </div>
          )
        }
      </div>
    </PrintSheet>
    {
      isNonEmptyArray(samplePages) && (
        <PrintSheet edge={getEdge('sample')} regs={['r']} bare>
          <div class="px-[0.9rem] py-[2.2rem] min-md:px-[2.6rem] min-md:py-[2.5rem]">
            <BookSample pages={samplePages} title={book.title} />
          </div>
        </PrintSheet>
      )
    }
    {
      isNonEmptyArray(galleryImages) && (
        <PrintSheet edge={getEdge('gallery')} regs={['r']} bare>
          <div class="px-[0.9rem] py-[2.2rem] min-md:px-[2.6rem] min-md:py-[2.5rem]">
            <BookGallery images={galleryImages} title={book.title} />
          </div>
        </PrintSheet>
      )
    }
    {
      sheetKeys.includes('meta') && (
        <PrintSheet edge={getEdge('meta')} regs={['r', 'b']}>
          <div class="grid gap-10 px-[0.9rem] py-[2.2rem] min-md:grid-cols-[minmax(0,1fr)_auto] min-md:px-[2.6rem] min-md:py-[2.5rem]">
            <div class="max-md:order-2">
              <BookCrew people={people} />
            </div>
            {hasMeta && (
              <div class="max-md:order-1">
                <BookMeta
                  cover={book.coverImage}
                  year={book.date}
                  pagesCount={book.pagesCount}
                  width={book.width}
                  height={book.height}
                  paper={book.paper}
                  font={book.font}
                  isbn={book.isbn}
                />
              </div>
            )}
          </div>
        </PrintSheet>
      )
    }
    {
      mainAuthor && isNonEmptyArray(authorsBooks) && (
        <PrintSheet
          edge={getEdge('author')}
          slug={`od-autora_${mainAuthor.data.slug}.pdf`}
        >
          <div class="px-[0.9rem] py-8 min-md:px-[2.6rem]">
            <h2 class="font-head mb-7 text-[1.9rem] leading-[1.1] font-extrabold text-balance">
              Další knihy od {getAuthorsSecondName(mainAuthor.data)}
            </h2>
            <BooksContactSheet books={authorsBooks} />
          </div>
        </PrintSheet>
      )
    }
    {
      isNonEmptyArray(otherCategoryBooks) && (
        <PrintSheet
          edge={getEdge('category')}
          regs={['b']}
          slug={`kategorie_${book.category}.pdf`}
        >
          <div class="px-[0.9rem] py-8 min-md:px-[2.6rem]">
            <h2 class="font-head mb-7 text-[1.9rem] leading-[1.1] font-extrabold text-balance">
              Další knihy {CATEGORIES[book.category].name}
            </h2>
            <BooksIndex books={otherCategoryBooks} />
            <div class="mt-10 pr-7 text-center">
              <ArrowLink tone="first" href={routes.books.list()}>
                Všechny knihy
              </ArrowLink>
            </div>
          </div>
        </PrintSheet>
      )
    }
  </div>
  <BookBgAlphaControl client:load />
</Layout>

<script>
  import '@/utils/colorTint'

  const STICK_OFFSET_PX = 24

  const observeStick = () => {
    const sentinel = document.querySelector('[data-stick-sentinel]')
    const target = document.querySelector('[data-reveal-on-stick]')

    if (sentinel && target) {
      new IntersectionObserver(
        ([entry]) => {
          if (entry) {
            target.toggleAttribute(
              'data-stuck',
              !entry.isIntersecting && entry.boundingClientRect.top < STICK_OFFSET_PX + 1,
            )
          }
        },
        { rootMargin: `-${String(STICK_OFFSET_PX + 1)}px 0px 0px 0px` },
      ).observe(sentinel)
    }
  }

  document.addEventListener('astro:page-load', observeStick)

  document.addEventListener('astro:before-preparation', (event) => {
    const slide =
      event.sourceElement instanceof HTMLElement
        ? event.sourceElement.closest<HTMLElement>('[data-slide]')?.dataset.slide
        : undefined

    if (slide) {
      document.documentElement.dataset.slide = slide
    }
  })

  document.addEventListener('astro:before-swap', (event) => {
    const { slide } = document.documentElement.dataset

    if (slide) {
      event.newDocument.documentElement.dataset.slide = slide
      void event.viewTransition.finished.then(() => {
        delete document.documentElement.dataset.slide
      })
    }
  })
</script>
