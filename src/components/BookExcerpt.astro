---
import { Image } from 'astro:assets'
import { getEntries, getEntry } from 'astro:content'

import ArrowLink from '@/components/ArrowLink.astro'
import BookBuy from '@/components/BookBuy.svelte'
import { routes } from '@/routes'
import { getExcerptText } from '@/utils/getExcerptText'
import { tp } from '@/utils/tp'

import FloatingImage from './FloatingImage.svelte'

type Props = {
  class?: string
  slug: string
  bleed?: boolean
}

const { slug, class: className, bleed = false } = Astro.props

const entry = await getEntry('book', slug)

if (!entry) {
  return
}

const { data: b } = entry

const claim = b.claim ?? (entry.body ? getExcerptText(entry.body, 260) : undefined)

const authors = await getEntries(
  b.authors.filter((a) => a.isMain && a.role.includes('author')).map((a) => a.slug),
)
---

<article class:list={['max-xs:flex max-xs:flex-col relative flex gap-8', className]}>
  <span
    class="text-brand-second-100/20 font-head bold absolute -top-10 -left-6 -z-1 text-6xl"
    >{b.order}</span
  >
  {
    (
      <a
        class:list={[
          'block w-[20rem] max-w-full flex-1',
          bleed && '-mt-[calc(var(--sheet-py)+3mm)] -ml-[calc(var(--sheet-px)+3mm)]',
        ]}
        href={routes.books.detail(slug)}
        tabindex="-1"
        aria-hidden="true"
      >
        <Image
          alt=""
          src={b.cover}
          width={158}
          widths={[158, 316, 480]}
          height={200}
          class:list={[
            'shadow-[0_0.3rem_1.4rem_rgba(0,0,0,0.18)]',
            bleed && 'h-auto w-full',
          ]}
        />
      </a>
    )
  }
  <div class="flex flex-4 flex-col gap-1">
    <h2
      class="font-head font-liga hyphenate text-brand-first-500 relative text-5xl leading-[1.2em] font-bold tracking-wide break-words"
    >
      <a href={routes.books.detail(slug)}>{tp(b.title)}</a>
      <span
        aria-hidden="true"
        class="font-alt text-brand-first-700/45 ml-1.5 text-[0.5em] font-normal select-none"
        >↵</span
      >
    </h2>

    <div class="flex gap-8 max-sm:flex-col">
      <div class="flex min-w-0 flex-1 flex-col gap-5">
        <div class="text-xl text-gray-500">
          {
            authors.map(({ data: a }, index) => (
              <>
                {index !== 0 ? ', ' : ''}
                <FloatingImage
                  client:visible
                  src={a.image?.src}
                  alt={`${a.firstname} ${a.surname}`}
                >
                  <a
                    class="group font-alt text-gray-500 transition-colors hover:text-black"
                    href={routes.authors.detail(a.slug)}
                  >
                    {a.firstname} {a.surname}
                  </a>
                </FloatingImage>
              </>
            ))
          }
          <span
            aria-hidden="true"
            class="font-alt text-brand-first-700/45 ml-1.5 text-[0.7em] font-normal select-none"
            >¶</span
          >
        </div>

        <p>
          {claim && tp(claim)}
          {' '}
          <ArrowLink
            tone="first"
            class="mr-7 whitespace-nowrap"
            href={routes.books.detail(slug)}
          >
            Více o knize
          </ArrowLink>
        </p>
      </div>

      <div class="flex shrink-0 flex-col items-start gap-5 pt-3 min-sm:w-[13rem]">
        <BookBuy
          client:visible
          slug={slug}
          kosmasUrl={b.kosmasUrl}
          price={b.price}
          stock={b.stock}
          isUpcoming={b.isUpcoming}
          releaseNote={b.releaseNote}
        />
      </div>
    </div>
  </div>
</article>
