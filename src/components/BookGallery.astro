---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'

import BookGallery from '@/components/BookGallery.svelte'

type Props = {
  images: ImageMetadata[]
  title: string
}

const THUMB_HEIGHT = 680
const FULL_WIDTH = 2000

const { images, title } = Astro.props

const items = await Promise.all(
  images.map(async (image, index) => {
    const [thumb, full] = await Promise.all([
      getImage({ src: image, height: THUMB_HEIGHT, format: 'webp' }),
      getImage({ src: image, width: Math.min(FULL_WIDTH, image.width), format: 'webp' }),
    ])
    return {
      alt: `${title}, fotografie ${String(index + 1)}`,
      ratio: image.width / image.height,
      thumb: thumb.src,
      full: full.src,
      fullWidth: Number(full.attributes.width),
      fullHeight: Number(full.attributes.height),
    }
  }),
)
---

<BookGallery client:visible items={items} />
