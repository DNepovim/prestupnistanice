---
import { Image } from 'astro:assets'

import { routes } from '../routes'
import ArrowLink from './ArrowLink.astro'
import FloatingPopup from './FloatingPopup.svelte'

type NavItem = {
  slug: string
  title: string
  order?: number
  cover?: {
    src: string
    width: number
    height: number
    format: 'png' | 'jpg' | 'jpeg' | 'tiff' | 'webp' | 'gif' | 'svg' | 'avif'
  }
}

type Props = {
  prev?: NavItem
  next?: NavItem
  order?: number
}

const { prev, next, order } = Astro.props
---

<div class="text-brand-first-500 mt-6 flex items-center justify-between px-8">
  <div class="flex-1 text-left">
    {
      prev && (
        <FloatingPopup client:visible>
          <ArrowLink hasArrowLeft href={routes.books.detail(prev.slug)} class="text-xs">
            {prev.order}. {prev.title}
          </ArrowLink>
          {prev.cover && (
            <div slot="popup" class="w-[168px]">
              <Image
                alt={prev.title}
                src={prev.cover}
                width={160}
                height={228}
                widths={[120, 160, 200]}
                sizes="160px"
                loading="eager"
                decoding="async"
                class="h-auto w-full border border-gray-200 shadow-xl"
              />
            </div>
          )}
        </FloatingPopup>
      )
    }
  </div>
  {order && <div class="text-brand-second-200 flex-1 text-center font-alt">{order}.</div>}
  <div class="flex-1 text-right">
    {
      next && (
        <FloatingPopup client:visible>
          <ArrowLink href={routes.books.detail(next.slug)} class="text-xs">
            {next.order}. {next.title}
          </ArrowLink>
          {next.cover && (
            <div slot="popup" class="w-[168px]">
              <Image
                alt={next.title}
                src={next.cover}
                width={160}
                height={228}
                widths={[120, 160, 200]}
                sizes="160px"
                loading="eager"
                decoding="async"
                class="h-auto w-full border border-gray-200 shadow-xl"
              />
            </div>
          )}
        </FloatingPopup>
      )
    }
  </div>
</div>
