---
import { routes } from '@/routes'

import ArrowLink from './ArrowLink.astro'
import FloatingImage from './FloatingImage.svelte'

type NavItem = {
  slug: string
  title: string
  order?: number
  cover?: {
    src: string
    width: number
    height: number
    format: 'png' | 'jpg' | 'jpeg' | 'tiff' | 'webp' | 'gif' | 'svg' | 'avif'
  }
}

type Props = {
  prev?: NavItem
  next?: NavItem
  order?: number
}

const { prev, next, order } = Astro.props
---

<div class="text-brand-first-500 mt-6 flex items-center justify-between px-8">
  <div class="flex-1 text-left">
    {
      prev && (
        <FloatingImage client:visible src={prev.cover?.src} alt={prev.title}>
          <ArrowLink hasArrowLeft href={routes.books.detail(prev.slug)} class="text-xs">
            {prev.order}. {prev.title}
          </ArrowLink>
        </FloatingImage>
      )
    }
  </div>
  {order && <div class="text-brand-second-200 font-alt text-center">{order}.</div>}
  <div class="flex-1 text-right">
    {
      next && (
        <FloatingImage client:visible src={next.cover?.src} alt={next.title}>
          <ArrowLink href={routes.books.detail(next.slug)} class="text-xs">
            {next.order}. {next.title}
          </ArrowLink>
        </FloatingImage>
      )
    }
  </div>
</div>
