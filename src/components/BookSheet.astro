---
import { Image } from 'astro:assets'
import { getEntries, type CollectionEntry } from 'astro:content'

import ArrowLink from '@/components/ArrowLink.astro'
import BookBuy from '@/components/BookBuy.svelte'
import ColorBar from '@/components/ColorBar.astro'
import FloatingImage from '@/components/FloatingImage.svelte'
import PrintSheet from '@/components/PrintSheet.astro'
import Theme from '@/components/Theme.astro'
import { FALLBACK_COLOR_FIRST, FALLBACK_COLOR_SECOND } from '@/consts'
import { CATEGORIES, routes } from '@/routes'
import { getExcerptText } from '@/utils/getExcerptText'
import type { SheetEdge } from '@/utils/getSheetEdge'
import { joinWords } from '@/utils/joinWords'
import { getTitleFit } from '@/utils/titleFit'
import { tp } from '@/utils/tp'

const TITLE_MAX_REM = 3.375
const TITLE_REFERENCE_WIDTH_REM = 26

type Props = {
  book: CollectionEntry<'book'>
  edge: SheetEdge
  viewTransition?: boolean
}

const { book: entry, edge, viewTransition = false } = Astro.props

const { data: b } = entry

const link = routes.books.detail(b.slug)

const titleFit = getTitleFit(tp(b.title), {
  maxFontRem: TITLE_MAX_REM,
  referenceWidthRem: TITLE_REFERENCE_WIDTH_REM,
})

const claim = b.claim ?? (entry.body ? getExcerptText(entry.body, 260) : undefined)

const authors = await getEntries(
  b.authors.filter((a) => a.isMain && a.role.includes('author')).map((a) => a.slug),
)

const authorsLine = joinWords(authors.map(({ data: a }) => `${a.firstname} ${a.surname}`))
const orderedTitle = `${String(b.order)}. ${b.title}`
const fileSlug = authorsLine ? `${orderedTitle} · ${authorsLine}` : orderedTitle
const sideSlug = `${String(b.date)} · ${CATEGORIES[b.category].name}`
---

<div
  class="animate-sheet-parallax"
  style={viewTransition
    ? `view-transition-name:book-${b.slug};view-transition-class:book`
    : undefined}
>
  <PrintSheet edge={edge} regs={['r']} slug={fileSlug} sideSlug={sideSlug}>
    <Theme keepHue firstColor={b.color ?? undefined} secondColor={b.bgColor ?? undefined}>
      <article
        data-tint-scope
        class="group/book relative grid grid-cols-1 gap-x-[1.8rem] gap-y-[1.4rem] [background-color:var(--tint-bg,white)] px-(--sheet-px) py-(--sheet-py) [--sheet-px:0.9rem] [--sheet-py:2.2rem] min-sm:grid-cols-[auto_minmax(0,1fr)] min-md:grid-cols-[auto_minmax(0,1fr)_12rem] min-md:[--sheet-px:2.6rem] min-md:[--sheet-py:2.5rem]"
      >
        <a
          href={link}
          class="-mt-[calc(var(--sheet-py)+3mm)] -ml-[calc(var(--sheet-px)+3mm)] block justify-self-start"
          tabindex="-1"
          aria-hidden="true"
        >
          <Image
            alt=""
            src={b.cover}
            width={240}
            widths={[240, 480, 720]}
            sizes="11rem"
            class="h-auto max-h-[16rem] w-auto max-w-[11rem] shadow-[0_0.3rem_1.4rem_rgba(0,0,0,0.18)]"
          />
        </a>

        <div class="flex min-w-0 flex-col gap-3">
          <div class="[container-type:inline-size]">
            <h2
              style={`--title-w:${titleFit.widthEm.toFixed(3)};--title-max:${String(TITLE_MAX_REM)}rem`}
              class="font-head font-liga text-brand-first-500 relative [font-size:min(var(--title-max),calc(100cqw/var(--title-w)))] leading-[1.04] font-extrabold tracking-[-0.02em]"
            >
              <a href={link} class="block w-fit">
                {
                  titleFit.lines.map((line, index) => (
                    <span class="block whitespace-nowrap">
                      {line}
                      {index === titleFit.lines.length - 1 && (
                        <span
                          aria-hidden="true"
                          class="font-alt text-brand-first-700/45 ml-[0.25em] align-baseline text-[0.3em] font-normal select-none"
                        >
                          ↵
                        </span>
                      )}
                    </span>
                  ))
                }
              </a>
            </h2>
          </div>

          <div class="font-alt text-[1.2rem] leading-[1.3] text-gray-800 italic">
            {
              authors.map(({ data: a }, index) => (
                <>
                  {index !== 0 ? ', ' : ''}
                  <FloatingImage
                    client:visible
                    src={a.image?.src}
                    alt={`${a.firstname} ${a.surname}`}
                  >
                    <a
                      class="transition-colors hover:text-black"
                      href={routes.authors.detail(a.slug)}
                    >
                      {a.firstname} {a.surname}
                    </a>
                  </FloatingImage>
                </>
              ))
            }
            <span
              aria-hidden="true"
              class="font-alt text-brand-first-700/45 ml-1.5 text-[0.7em] font-normal not-italic select-none"
              >¶</span
            >
          </div>

          {claim && <p class="font-alt line-clamp-3 leading-[1.5] italic">{tp(claim)}</p>}
          <div>
            <ArrowLink tone="first" class="mr-7 whitespace-nowrap" href={link}>
              Více o knize
            </ArrowLink>
          </div>
        </div>

        <div class="flex shrink-0 flex-col items-start pt-3 min-sm:max-md:col-span-full">
          <BookBuy
            client:visible
            slug={b.slug}
            title={b.title}
            kosmasUrl={b.kosmasUrl}
            price={b.price}
            isUpcoming={b.isUpcoming}
            releaseNote={b.releaseNote}
          />
        </div>

        <ColorBar
          variant="strip"
          from={b.color ?? FALLBACK_COLOR_FIRST}
          to={b.bgColor ?? FALLBACK_COLOR_SECOND}
          class="absolute inset-x-0 bottom-0"
        />
      </article>
    </Theme>
  </PrintSheet>
</div>

<script>
  import '@/utils/colorTint'
</script>
