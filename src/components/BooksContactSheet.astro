---
import { Image } from 'astro:assets'
import { getEntries, type CollectionEntry } from 'astro:content'
import { isNonEmptyArray } from 'narrowland'

import FloatingImage from '@/components/FloatingImage.svelte'
import { FALLBACK_COLOR_FIRST } from '@/consts'
import { routes } from '@/routes'
import { tp } from '@/utils/tp'

type Props = {
  books: CollectionEntry<'book'>[]
  authorSlug?: string
}

const HANDLES = [
  [0, 0],
  [50, 0],
  [100, 0],
  [0, 50],
  [100, 50],
  [0, 100],
  [50, 100],
  [100, 100],
] as const

const COLUMNS = Array.from({ length: 12 }, (_, index) => index)

const COLUMN_GAP = 'gap-x-2 min-sm:gap-x-6'

const { books: unsortedBooks, authorSlug } = Astro.props

const items = await Promise.all(
  unsortedBooks
    .toSorted((a, b) => b.data.order - a.data.order)
    .map(async (book) => {
      const coAuthors = authorSlug
        ? await getEntries(
            book.data.authors
              .filter((a) => a.isMain && a.slug.id !== authorSlug)
              .map((a) => a.slug),
          )
        : []
      const coAuthorLinks = coAuthors.flatMap(({ data: a }) =>
        a.firstnameSeventh && a.surnameSeventh
          ? [
              {
                name: `${a.firstnameSeventh} ${a.surnameSeventh}`,
                href: routes.authors.detail(a.slug),
                image: a.image?.src,
              },
            ]
          : [],
      )
      return { book, coAuthorLinks }
    }),
)
---

<div class="-mx-3 overflow-clip px-3">
  <div class="relative">
    <div
      aria-hidden="true"
      class:list={['pointer-events-none absolute inset-0 grid grid-cols-12', COLUMN_GAP]}
    >
      {COLUMNS.map(() => <span class="bg-brand-second-200/12" />)}
    </div>
    <ul class:list={['relative grid grid-cols-12 gap-y-9 py-6', COLUMN_GAP]}>
      {
        items.map(({ book, coAuthorLinks }) => (
          <li class="col-span-6 min-w-0 min-sm:col-span-4 min-md:col-span-3">
            <div
              style={`--c1:${book.data.color ?? FALLBACK_COLOR_FIRST}`}
              class="group/cell relative flex min-w-0 flex-col gap-3"
            >
              <span class="flex aspect-[3/5] items-end justify-start">
                <span class="relative block w-full">
                  <Image
                    src={book.data.cover}
                    alt=""
                    width={520}
                    class="h-auto w-full shadow-[0_0.2rem_0.9rem_rgba(0,0,0,0.18)] transition-transform duration-300 group-hover/cell:-translate-y-0.5"
                  />
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute -inset-2 border border-(--c1) opacity-0 transition-opacity duration-200 group-hover/cell:opacity-100 group-has-[:focus-visible]/cell:opacity-100"
                  >
                    <span class="absolute top-0 left-[-100vw] h-px w-[200vw] bg-(--c1)/70" />
                    <span class="absolute bottom-0 left-[-100vw] h-px w-[200vw] bg-(--c1)/70" />
                    <span class="absolute top-[-100vh] left-0 h-[200vh] w-px bg-(--c1)/70" />
                    <span class="absolute top-[-100vh] right-0 h-[200vh] w-px bg-(--c1)/70" />
                    {HANDLES.map(([x, y]) => (
                      <span
                        style={`left:${String(x)}%;top:${String(y)}%`}
                        class="bg-paper absolute size-[0.42rem] -translate-x-1/2 -translate-y-1/2 border border-(--c1)"
                      />
                    ))}
                  </span>
                </span>
              </span>
              <b class="font-head text-[1.3rem] leading-[1.12] font-extrabold text-balance">
                <a
                  href={routes.books.detail(book.data.slug)}
                  class="after:absolute after:inset-0 focus-visible:after:outline-2 focus-visible:after:outline-offset-4 focus-visible:after:outline-(--c1)"
                >
                  {tp(book.data.title)}
                </a>
              </b>
              {isNonEmptyArray(coAuthorLinks) && (
                <span class="font-alt pointer-events-none relative z-10 block text-[0.9rem] leading-[1.3] text-gray-800 italic">
                  {coAuthorLinks.map((coAuthor, index) => (
                    <>
                      {index === 0
                        ? 's '
                        : index === coAuthorLinks.length - 1
                          ? ' a '
                          : ', '}
                      <FloatingImage
                        client:visible
                        src={coAuthor.image}
                        alt={coAuthor.name}
                      >
                        <a
                          class="pointer-events-auto transition-colors hover:text-black"
                          href={coAuthor.href}
                        >
                          {coAuthor.name}
                        </a>
                      </FloatingImage>
                    </>
                  ))}
                </span>
              )}
              {(book.data.isUpcoming === true || !authorSlug) && (
                <small class="font-alt text-brand-first-700 text-[0.7rem] leading-[1.3] tracking-[0.06em] uppercase">
                  {book.data.isUpcoming
                    ? (book.data.releaseNote ?? 'připravujeme')
                    : book.data.date}
                </small>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</div>
