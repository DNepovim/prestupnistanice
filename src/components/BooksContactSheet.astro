---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { getEntries } from 'astro:content'

import { FALLBACK_COLOR_FIRST, FALLBACK_COLOR_SECOND } from '@/consts'
import { routes } from '@/routes'
import { joinWords } from '@/utils/joinWords'
import { tp } from '@/utils/tp'

type Props = {
  books: CollectionEntry<'book'>[]
}

const { books } = Astro.props

const items = await Promise.all(
  books.map(async (b) => {
    const authors = await getEntries(
      b.data.authors.filter((a) => a.isMain).map((a) => a.slug),
    )
    return {
      book: b,
      authors: joinWords(authors.map((a) => `${a.data.firstname} ${a.data.surname}`)),
    }
  }),
)
---

<ul
  class="grid grid-cols-2 gap-x-6 gap-y-9 min-sm:grid-cols-[repeat(auto-fill,minmax(9.2rem,1fr))]"
>
  {
    items.map(({ book, authors }) => (
      <li class="min-w-0">
        <a
          href={routes.books.detail(book.data.slug)}
          style={`--c1:${book.data.color ?? FALLBACK_COLOR_FIRST};--c2:${book.data.bgColor ?? FALLBACK_COLOR_SECOND}`}
          class="group/cell flex min-w-0 flex-col gap-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-(--c1)"
        >
          <span class="before:border-brand-first-300/60 after:border-brand-first-300/60 relative flex h-[12.6rem] items-end justify-center p-[0.7rem] before:absolute before:top-0 before:left-0 before:size-4 before:border-t before:border-l before:transition-all group-hover/cell:before:size-6 group-hover/cell:before:border-(--c1) group-focus-visible/cell:before:border-(--c1) after:absolute after:right-0 after:bottom-0 after:size-4 after:border-r after:border-b after:transition-all group-hover/cell:after:size-6 group-hover/cell:after:border-(--c1) group-focus-visible/cell:after:border-(--c1)">
            <Image
              src={book.data.cover}
              alt=""
              width={260}
              class="h-auto max-h-full w-auto max-w-full shadow-[0_0.2rem_0.9rem_rgba(0,0,0,0.18)] transition-transform duration-300 group-hover/cell:-translate-y-1"
            />
          </span>
          <b class="font-head text-[1.02rem] leading-[1.15] font-extrabold text-balance">
            {tp(book.data.title)}
          </b>
          <small class="font-alt text-brand-first-700 text-[0.64rem] leading-[1.3] tracking-[0.06em] uppercase">
            {authors} · {book.data.date}
          </small>
          <span aria-hidden="true" class="flex h-2 w-16 opacity-70">
            <i class="flex-1 bg-(--c1)" />
            <i class="flex-1 bg-(--c2)" />
          </span>
        </a>
      </li>
    ))
  }
</ul>
