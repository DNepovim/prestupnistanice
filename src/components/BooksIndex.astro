---
import { getImage } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { getEntries } from 'astro:content'

import AddToCart from '@/components/AddToCart.svelte'
import FloatingImage from '@/components/FloatingImage.svelte'
import LinkPreviewScript from '@/components/LinkPreviewScript.astro'
import { FALLBACK_COLOR_FIRST } from '@/consts'
import { routes } from '@/routes'
import { formatPrice } from '@/utils/formatPrice'
import { isOnSale } from '@/utils/isOnSale'
import { tp } from '@/utils/tp'

type Props = {
  books: CollectionEntry<'book'>[]
}

const PREVIEW_WIDTH = 336

const getSeparator = (index: number, total: number) => {
  if (index === 0) {
    return ''
  }
  return index === total - 1 ? ' a ' : ', '
}

const { books: unsortedBooks } = Astro.props

const books = unsortedBooks.toSorted((a, b) => b.data.order - a.data.order)

const items = await Promise.all(
  books.map(async (b) => {
    const [authors, preview] = await Promise.all([
      getEntries(b.data.authors.filter((a) => a.isMain).map((a) => a.slug)),
      getImage({ src: b.data.cover, width: PREVIEW_WIDTH }),
    ])
    return {
      book: b,
      preview: preview.src,
      authors: authors.map((a) => ({
        slug: a.data.slug,
        name: `${a.data.firstname} ${a.data.surname}`,
        image: a.data.image?.src,
      })),
    }
  }),
)
---

<ul class="border-brand-first-300/60 border-t border-dashed">
  {
    items.map(({ book, preview, authors }) => (
      <li
        style={`--c1:${book.data.color ?? FALLBACK_COLOR_FIRST}`}
        class="group/row border-brand-first-300/60 relative grid grid-cols-[2.4rem_minmax(0,1fr)_auto] items-start gap-x-4 border-b border-dashed px-1 py-3 transition-colors hover:bg-[color-mix(in_srgb,var(--c1)_9%,transparent)]"
      >
        <span class="font-head text-brand-first-700 text-right text-[1.3rem] leading-[1.1] font-extrabold oldstyle-nums">
          {book.data.order}.
        </span>
        <span class="min-w-0">
          <a
            href={routes.books.detail(book.data.slug)}
            data-preview={preview}
            class="font-head text-[1.3rem] leading-[1.1] font-extrabold transition-colors group-hover/row:text-(--c1) after:absolute after:inset-0 focus-visible:after:outline-2 focus-visible:after:-outline-offset-2 focus-visible:after:outline-(--c1)"
          >
            {tp(book.data.title)}
          </a>
          <span class="font-alt relative z-10 mt-1 block text-[0.95rem] leading-tight text-gray-700 italic">
            {authors.map((author, index) => (
              <>
                {getSeparator(index, authors.length)}
                <FloatingImage client:visible src={author.image} alt={author.name}>
                  <a
                    class="transition-colors hover:text-black"
                    href={routes.authors.detail(author.slug)}
                  >
                    {author.name}
                  </a>
                </FloatingImage>
              </>
            ))}
          </span>
        </span>
        <span class="font-alt flex flex-col items-end gap-2">
          {book.data.isUpcoming && (
            <>
              <span class="font-head text-[1.2rem] leading-none font-extrabold text-black">
                Připravujeme
              </span>
              {book.data.releaseNote && (
                <span class="text-brand-first-700 text-right text-[0.75rem] leading-snug">
                  {book.data.releaseNote}
                </span>
              )}
            </>
          )}
          {isOnSale(book) && book.data.price !== undefined && (
            <span class="font-head text-[1.6rem] leading-none font-extrabold text-black [font-variant-numeric:lining-nums]">
              {formatPrice(book.data.price)}
            </span>
          )}
          {isOnSale(book) && (
            <AddToCart
              client:visible
              slug={book.data.slug}
              title={book.data.title}
            />
          )}
          {!book.data.isUpcoming && !isOnSale(book) && book.data.kosmasUrl && (
            <a
              href={book.data.kosmasUrl}
              target="_blank"
              rel="noopener"
              data-arrow-link
              class="group font-head text-brand-first-700 relative z-10 inline-block pr-9 text-[1.2rem] leading-none font-extrabold whitespace-nowrap"
            >
              Kup na Kosmasu
              <span
                aria-hidden="true"
                data-arrow="right"
                class="absolute top-1/2 right-[2px] block size-2 -translate-y-1/2 rotate-45 border-t-2 border-r-2 border-current"
              />
              <span
                aria-hidden="true"
                data-arrow="right"
                class="absolute top-1/2 right-0 block h-[2px] w-5 -translate-y-1/2 bg-current transition-all duration-500 group-hover:w-full group-focus-visible:w-full"
              />
              <span class="sr-only">(otevře se v novém okně)</span>
            </a>
          )}
          {!book.data.isUpcoming && !isOnSale(book) && !book.data.kosmasUrl && (
            <span class="text-[0.75rem] leading-snug text-gray-700">Není v prodeji</span>
          )}
        </span>
      </li>
    ))
  }
</ul>
<LinkPreviewScript />
