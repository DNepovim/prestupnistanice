---
import type { HTMLAttributes } from 'astro/types'

import { WAVE_ORIGIN_CLASSES, WAVE_STEP_CLASS } from '@/utils/waveStepClass'

type Props = {
  variant?: keyof typeof VARIANTS
  grow?: keyof typeof WAVE_ORIGIN_CLASSES
  class?: HTMLAttributes<'div'>['class']
}

const SWATCHES = [
  'bg-[#fff23d]',
  'bg-[#c8317e]',
  'bg-[#00a0dc]',
  'bg-[#2b2c80]',
  'bg-[#009a4e]',
  'bg-[#c8383a]',
  'bg-[#1a1a1a]',
  'bg-[#fff7a0]',
  'bg-[#e09ab8]',
  'bg-[#8ac8e6]',
  'bg-[#8c8c8c]',
] as const

const VARIANTS = {
  inline: { bar: 'pointer-events-none', step: '', isInteractive: false },
  wave: { bar: 'group/bar', step: WAVE_STEP_CLASS, isInteractive: true },
} as const satisfies Record<string, { bar: string; step: string; isInteractive: boolean }>

const { variant = 'inline', grow = 'down', class: className } = Astro.props
const { bar, step: variantStep, isInteractive } = VARIANTS[variant]
---

<div aria-hidden="true" class:list={['flex opacity-50', bar, className]}>
  {
    SWATCHES.map((swatch) => (
      <span
        data-color-step={isInteractive ? '' : undefined}
        class:list={[
          'block h-[1.1rem] w-[1.9rem]',
          swatch,
          variantStep,
          variant === 'wave' && WAVE_ORIGIN_CLASSES[grow],
        ]}
      />
    ))
  }
</div>
