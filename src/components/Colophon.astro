---
import type { HTMLAttributes } from 'astro/types'

type Row = {
  label: string
  value: string
}

type Props = {
  rows: Row[]
  class?: HTMLAttributes<'dl'>['class']
}

const { rows, class: className } = Astro.props
---

<dl class:list={['grid gap-[0.55rem]', className]}>
  {
    rows.map((row) => (
      <div class="flex items-baseline gap-2">
        <dt class="font-alt text-brand-first-700 flex flex-1 items-baseline gap-2 text-[0.62rem] leading-[1.2] tracking-[0.1em] whitespace-nowrap uppercase after:border-brand-first-300/60 after:min-w-4 after:flex-1 after:-translate-y-[0.2em] after:border-b after:border-dotted after:content-['']">
          {row.label}
        </dt>
        <dd class="text-right text-[0.95rem] leading-[1.3] font-medium [font-variant-numeric:lining-nums]">
          {row.value}
        </dd>
      </div>
    ))
  }
</dl>
