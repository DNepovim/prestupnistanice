---
import { Icon } from 'astro-icon/components'

import HeaderLink from '@/components/HeaderLink.astro'
import { tp } from '@/utils/tp'

const EYEBROW =
  'font-alt text-brand-second-200 mb-5 text-[0.7rem] leading-none tracking-[0.1em] uppercase'
const LINK = 'focus-visible:outline-2 focus-visible:outline-brand-second-200'
const CREDIT_LINK =
  'text-white text-[1em]! focus-visible:outline-2 focus-visible:outline-brand-second-200'
const NEW_WINDOW = '(otevře se v novém okně)'
---

<div class="footer-slot mt-8">
<footer class="footer-reveal font-alt bg-brand-first-700 overflow-hidden text-white">
<div class="relative mx-auto w-full max-w-[68rem] [container-type:inline-size]">
  <span aria-hidden="true" class="absolute top-4 left-4 size-5 border-t border-l border-brand-second-300/60"></span>
  <span aria-hidden="true" class="absolute top-4 right-4 size-5 border-t border-r border-brand-second-300/60"></span>
  <span aria-hidden="true" class="absolute bottom-4 left-4 size-5 border-b border-l border-brand-second-300/60"></span>
  <span aria-hidden="true" class="absolute right-4 bottom-4 size-5 border-r border-b border-brand-second-300/60"></span>

  <div class="px-[0.9rem] pt-16 min-md:px-[2.6rem] min-md:pt-20 min-[1100px]:px-[5rem]">
    <form class="max-w-[64rem]">
      <label for="newsletter-email" class="sr-only">E-mail pro odběr novinek</label>
      <p
        class="font-head max-w-[21em] text-[clamp(1.9rem,6.2cqw,3.7rem)] leading-[1.15] font-extrabold tracking-[-0.01em] text-balance"
      >
        {tp('Posílejte mi novinky z nakladatelství na')}
        <input
          id="newsletter-email"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder={tp('váš e-mail')}
          class="border-brand-second-300 w-[min(100%,8.5em)] border-b-2 border-dashed bg-transparent px-[0.1em] font-[inherit] text-white outline-none placeholder:text-white/50 focus:border-solid"
        />
        <button
          type="submit"
          aria-label="Odeslat"
          class="bg-white text-brand-first-900 hover:bg-white/80 ml-[0.2em] inline-grid size-[1.1em] cursor-pointer place-items-center align-[-0.12em] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white motion-reduce:transition-none"
        >
          <Icon name="ph:arrow-right-bold" class="size-[55%]" aria-hidden="true" />
        </button>
      </p>
      <p class="mt-5 text-[0.7rem] leading-none tracking-[0.1em] text-white/70 uppercase">
        Dozvíte se o každé nové knize. Odhlásit se můžete kdykoli.
      </p>
    </form>

    <div
      class="mt-14 grid max-w-[64rem] gap-10 border-t border-dashed border-brand-second-300/60 pt-8 min-md:grid-cols-[2fr_3fr_3fr]"
    >
      <nav aria-label="Obsah webu">
        <h2 class={EYEBROW}>Obsah</h2>
        <menu class="flex flex-col gap-2 text-[1rem] leading-tight">
          <li><HeaderLink class={LINK} href="/knihy">Naše knihy</HeaderLink></li>
          <li><HeaderLink class={LINK} href="/autori">Autoři</HeaderLink></li>
          <li><HeaderLink class={LINK} href="/o-nakladatelstvi">O nakladatelství</HeaderLink></li>
        </menu>
      </nav>

      <div>
        <h2 class={EYEBROW}>Kontakty</h2>
        <p class="mb-3 flex items-center gap-3 text-[1rem] leading-tight">
          <Icon
            name="ph:envelope-light"
            class="text-brand-second-200 size-5"
            aria-hidden="true"
          />
          <HeaderLink class={LINK} href="mailto:skalak@knihyps.cz">skalak@knihyps.cz</HeaderLink>
        </p>
        <p class="flex items-center gap-3 text-[1rem] leading-tight">
          <Icon
            name="ph:facebook-logo-light"
            class="text-brand-second-200 size-5"
            aria-hidden="true"
          />
          <HeaderLink
            class={LINK}
            href="https://www.facebook.com/knihyprestupnistanice"
            target="_blank"
            rel="noopener noreferrer"
            >knihyprestupnistanice<span class="sr-only">{NEW_WINDOW}</span></HeaderLink
          >
        </p>
      </div>

      <div>
        <h2 class={EYEBROW}>Tiráž</h2>
        <p class="text-[0.8rem] leading-[1.6] text-white/80">
          Naše knihy jsou dostupné v distribuci <HeaderLink
            class={CREDIT_LINK}
            href="https://www.kosmas.cz/nakladatelstvi/877130/prestupni-stanice/"
            >Kosmas</HeaderLink
          >.
        </p>
        <p class="mt-3 text-[0.8rem] leading-[1.6] text-white/80">
          Web písmy <HeaderLink
            class={CREDIT_LINK}
            href="https://fonts.google.com/specimen/Alegreya"
            target="_blank"
            rel="noopener noreferrer"
            >Alegreya<span class="sr-only">{NEW_WINDOW}</span></HeaderLink
          > a <HeaderLink
            class={CREDIT_LINK}
            href="https://fonts.adobe.com/fonts/montserrat"
            target="_blank"
            rel="noopener noreferrer"
            >Montserrat<span class="sr-only">{NEW_WINDOW}</span></HeaderLink
          > vysázel <HeaderLink
            class={CREDIT_LINK}
            href="https://www.dominikblaha.cz"
            target="_blank"
            rel="noopener noreferrer"
            >Dominik Bláha<span class="sr-only">{NEW_WINDOW}</span></HeaderLink
          >.
        </p>
      </div>
    </div>
  </div>

  <span
    aria-hidden="true"
    class="font-display text-stroke-brand-second-300 pointer-events-none mt-14 block h-[0.76em] overflow-hidden px-[0.9rem] pt-[0.1em] text-[8.4cqw] leading-[0.8] font-extrabold tracking-[-0.02em] whitespace-nowrap text-transparent select-none min-md:px-[2.6rem] min-[1100px]:px-[5rem]"
  >
    Přestupní stanice
  </span>
</div>
</footer>
</div>

<style>
  @supports (animation-timeline: view()) {
    @keyframes footer-reveal {
      from {
        clip-path: inset(100% 0 0 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }

    .footer-slot {
      view-timeline: --footer-slot block;
    }

    .footer-reveal {
      position: sticky;
      bottom: 0;
      z-index: -10;
      animation: footer-reveal linear both;
      animation-timeline: --footer-slot;
      animation-range: entry 0% entry 100%;
    }
  }
</style>
