---
import { Icon } from 'astro-icon/components'

import PrintSheet from '@/components/PrintSheet.astro'

const EYEBROW =
  'font-alt text-brand-first-700 mb-5 text-[0.7rem] leading-none tracking-[0.1em] uppercase'
const LINK = 'hover:text-brand-first-700 underline-offset-4 hover:underline'
const CREDIT_LINK = 'underline underline-offset-2 hover:text-black'
---

<footer class="font-alt mt-8">
  <PrintSheet edge="only" regs={['b']} class="mb-20!">
    <div
      class="grid gap-10 px-[0.9rem] py-8 min-md:grid-cols-[2fr_3fr_3fr] min-md:px-[2.6rem]"
    >
      <nav aria-label="Obsah webu">
        <h2 class={EYEBROW}>Obsah</h2>
        <menu class="flex flex-col gap-2 text-[1rem] leading-tight">
          <li><a class={LINK} href="/knihy">Naše knihy</a></li>
          <li><a class={LINK} href="/autori">Autoři</a></li>
          <li><a class={LINK} href="/o-nakladatelstvi">O nakladatelství</a></li>
        </menu>
      </nav>

      <div>
        <h2 class={EYEBROW}>Kontakty</h2>
        <p class="mb-3 flex items-center gap-3 text-[1rem] leading-tight">
          <Icon
            name="ph:envelope-light"
            class="text-brand-first-700 size-5"
            aria-hidden="true"
          />
          <a class={LINK} href="mailto:skalak@knihyps.cz">skalak@knihyps.cz</a>
        </p>
        <p class="flex items-center gap-3 text-[1rem] leading-tight">
          <Icon
            name="ph:facebook-logo-light"
            class="text-brand-first-700 size-5"
            aria-hidden="true"
          />
          <a
            class={LINK}
            href="https://www.facebook.com/knihyprestupnistanice"
            target="_blank"
            rel="noopener noreferrer">knihyprestupnistanice</a
          >
        </p>
      </div>

      <div>
        <h2 class={EYEBROW}>Tiráž</h2>
        <p class="text-[0.8rem] leading-[1.6] text-gray-800">
          Naše knihy jsou dostupné v distribuci <a
            class={CREDIT_LINK}
            href="https://www.kosmas.cz/nakladatelstvi/877130/prestupni-stanice/"
            >Kosmas</a
          >.
        </p>
        <p class="mt-3 text-[0.8rem] leading-[1.6] text-gray-800">
          Web písmy <a
            class={CREDIT_LINK}
            href="https://fonts.google.com/specimen/Alegreya"
            target="_blank"
            rel="noopener noreferrer">Alegreya</a
          > a <a
            class={CREDIT_LINK}
            href="https://fonts.adobe.com/fonts/montserrat"
            target="_blank"
            rel="noopener noreferrer">Montserrat</a
          > vysázel <a
            class={CREDIT_LINK}
            href="https://www.dominikblaha.cz"
            target="_blank"
            rel="noopener noreferrer">Dominik Bláha</a
          >.
        </p>
      </div>
    </div>
  </PrintSheet>
</footer>
