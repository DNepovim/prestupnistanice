---
import { getImage } from 'astro:assets'
import { getCollection } from 'astro:content'
import { isDefined } from 'narrowland'

import MobileMenu from '@/components/MobileMenu.svelte'
import SearchButton from '@/components/SearchButton.svelte'
import { routes } from '@/routes'
import { joinWords } from '@/utils/joinWords'

import HeaderLink from './HeaderLink.astro'

const books = await getCollection('book')
const authors = await getCollection('author')

const bookItems = await Promise.all(
  books.map(async ({ data: { title, cover, slug, authors: as } }) => {
    const optimized = await getImage({ src: cover, width: 160, format: 'webp' })
    return {
      slug,
      title,
      subtitle: joinWords(
        as
          .filter((a) => a.isMain)
          .map((a) => {
            const author = authors.find((as) => as.data.slug === a.slug.id)
            if (!author) {
              return null
            }
            return `${author.data.firstname} ${author.data.surname}`
          })
          .filter(isDefined),
      ),
      image: optimized,
      link: `/knihy/${slug}`,
      type: 'book' as const,
    }
  }),
)

const authorMainEntries = books
  .flatMap((b) => b.data.authors)
  .filter((a) => a.isMain)
  .map((a) => authors.find((au) => au.id === a.slug.id))
  .filter(isDefined)

const authorItems = await Promise.all(
  authorMainEntries.map(async ({ data: { firstname, surname, image, slug } }) => {
    const optimized = image
      ? await getImage({
          src: image,
          width: 160,
          height: 160,
          fit: 'cover',
          format: 'webp',
        })
      : undefined
    return {
      slug,
      title: `${firstname} ${surname}`,
      image: optimized,
      link: `/autori/${slug}`,
      type: 'author' as const,
    }
  }),
)

const searchData = [...bookItems, ...authorItems].filter(
  (item, index, arr) => index === arr.findIndex((el) => el.slug === item.slug),
)

type Props = {
  tinted?: boolean
}

const { tinted = false } = Astro.props

const navigations = [
  {
    link: routes.books.list(),
    label: 'Naše knihy',
  },
  {
    link: '/o-nakladatelstvi',
    label: 'O nakladatelství',
  },
]
---

<header
  class:list={[
    'site-header sticky top-0 z-0 min-w-full pt-2 has-[[aria-expanded=true]]:z-20 has-[[role=dialog]]:z-20',
    tinted && 'bg-brand-first-500 text-white',
  ]}
>
  <div
    class="header-content mx-auto flex w-[calc(var(--slide-size)-var(--slide-spacing))] items-center justify-between gap-4 py-1"
  >
    <p
      class="font-liga font-head m-0 whitespace-nowrap text-inherit max-md:text-[4.3vw] min-md:text-3xl"
    >
      <a class="no-underline" href="/">Přestupní stanice</a>
    </p>
    <div class="flex items-center gap-3 min-md:gap-4">
      <nav aria-label="Hlavní navigace" class="flex items-center gap-4 max-md:hidden">
        {
          navigations.map(({ link, label }, index) => (
            <>
              {index !== 0 && (
                <span
                  aria-hidden="true"
                  class="mr-2 inline-block h-[1px] w-8 bg-current opacity-30"
                />
              )}
              <HeaderLink href={link}>{label}</HeaderLink>
            </>
          ))
        }
      </nav>
      <div class="min-md:hidden">
        <MobileMenu client:idle navigations={navigations} />
      </div>
      <span
        aria-hidden="true"
        class="mr-2 inline-block h-[1px] w-8 bg-current opacity-30 max-md:hidden"></span>
      <SearchButton client:idle data={searchData} />
    </div>
  </div>
</header>

<style>
  @supports (animation-timeline: scroll()) {
    @keyframes header-fade-out {
      to {
        opacity: 0;
      }
    }

    .header-content {
      animation: header-fade-out linear both;
      animation-timeline: scroll(root);
      animation-range: 0 5rem;
    }

    .site-header:has([aria-expanded='true']) .header-content,
    .site-header:has([role='dialog']) .header-content {
      animation: none;
    }
  }
</style>
