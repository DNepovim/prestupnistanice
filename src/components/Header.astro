---
import { getImage } from 'astro:assets'
import { getCollection } from 'astro:content'
import { isDefined } from 'narrowland'

import SearchButton from '@/components/SearchButton.svelte'
import { routes } from '@/routes'
import { joinWords } from '@/utils/joinWords'

import HeaderLink from './HeaderLink.astro'

const books = await getCollection('book')
const authors = await getCollection('author')

const bookItems = await Promise.all(
  books.map(async ({ data: { title, cover, slug, authors: as } }) => {
    const optimized = await getImage({ src: cover, width: 160, format: 'webp' })
    return {
      slug,
      title,
      subtitle: joinWords(
        as
          .filter((a) => a.isMain)
          .map((a) => {
            const author = authors.find((as) => as.data.slug === a.slug.id)
            if (!author) {
              return null
            }
            return `${author.data.firstname} ${author.data.surname}`
          })
          .filter(isDefined),
      ),
      image: optimized,
      link: `/knihy/${slug}`,
      type: 'book' as const,
    }
  }),
)

const authorMainEntries = books
  .flatMap((b) => b.data.authors)
  .filter((a) => a.isMain)
  .map((a) => authors.find((au) => au.id === a.slug.id))
  .filter(isDefined)

const authorItems = await Promise.all(
  authorMainEntries.map(async ({ data: { firstname, surname, image, slug } }) => {
    const optimized = image
      ? await getImage({ src: image, width: 160, format: 'webp' })
      : undefined
    return {
      slug,
      title: `${firstname} ${surname}`,
      image: optimized,
      link: `/autori/${slug}`,
      type: 'author' as const,
    }
  }),
)

const searchData = [...bookItems, ...authorItems].filter(
  (item, index, arr) => index === arr.findIndex((el) => el.slug === item.slug),
)

const navigations = [
  {
    link: routes.books.list(),
    label: 'Naše knihy',
  },
  {
    link: '/o-nakladatelstvi',
    label: 'O nakladatelství',
  },
]
---

<header class="min-w-full px-6">
  <div
    class="mx-auto mt-2 flex max-w-[56rem] items-center justify-between gap-4 py-1 transition-colors max-lg:flex-col"
  >
    <p
      class="font-liga font-head text-brand-first-500 m-0 text-3xl transition-colors duration-500 hover:text-black"
    >
      <a class="no-underline" href="/">Přestupní stanice</a>
    </p>
    <nav
      aria-label="Hlavní navigace"
      class="internal-links max-xs:justify-center flex flex-wrap items-center gap-4"
    >
      {
        navigations.map(({ link, label }, index) => (
          <>
            {index !== 0 && (
              <span
                aria-hidden="true"
                class="mr-2 inline-block h-[1px] w-8 bg-gray-300 max-sm:hidden"
              />
            )}
            <HeaderLink href={link}>{label}</HeaderLink>
          </>
        ))
      }
      <span
        aria-hidden="true"
        class="mr-2 inline-block h-[1px] w-8 bg-gray-300 max-sm:hidden"></span>
      <SearchButton client:idle data={searchData} />
    </nav>
  </div>
</header>
