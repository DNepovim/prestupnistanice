---
import MobileMenu from '@/components/MobileMenu.svelte'
import SearchButton from '@/components/SearchButton.svelte'
import { routes } from '@/routes'
import { getSearchIndex } from '@/utils/search/getSearchIndex'

import HeaderLink from './HeaderLink.astro'

const searchIndex = await getSearchIndex()

type Props = {
  tinted?: boolean
}

const { tinted = false } = Astro.props

const navigations = [
  {
    link: routes.books.list(),
    label: 'Naše knihy',
  },
  {
    link: '/o-nakladatelstvi',
    label: 'O nakladatelství',
  },
]
---

<header
  class:list={[
    'site-header sticky top-0 z-0 min-w-full pt-2 has-[[aria-expanded=true]]:z-20 has-[[role=dialog]]:z-20',
    tinted &&
      'bg-[color-mix(in_srgb,color-mix(in_srgb,var(--tint-bg,var(--color-brand-first-500))_70%,white)_calc(100%_*_(1_-_min(1,_var(--footer-progress,0)_*_10))),transparent)] [color:var(--tint-fg,var(--color-brand-first-500))]',
  ]}
>
  <div
    class="header-content mx-auto flex w-[calc(var(--slide-size)-var(--slide-spacing))] items-center justify-between gap-4 py-1"
  >
    <p
      class="font-liga font-head m-0 whitespace-nowrap text-inherit max-md:text-[4.3vw] min-md:text-3xl"
    >
      <a class="no-underline" href="/">Přestupní stanice</a>
    </p>
    <div class="flex items-center gap-3 min-md:gap-4">
      <nav aria-label="Hlavní navigace" class="flex items-center gap-4 max-md:hidden">
        {
          navigations.map(({ link, label }, index) => (
            <>
              {index !== 0 && (
                <span
                  aria-hidden="true"
                  class="mr-2 inline-block h-[1px] w-8 bg-current opacity-30"
                />
              )}
              <HeaderLink href={link}>{label}</HeaderLink>
            </>
          ))
        }
      </nav>
      <div class="min-md:hidden">
        <MobileMenu client:idle navigations={navigations} />
      </div>
      <span
        aria-hidden="true"
        class="mr-2 inline-block h-[1px] w-8 bg-current opacity-30 max-md:hidden"></span>
      <SearchButton client:idle data={searchIndex} />
    </div>
  </div>
</header>

<style>
  @supports (animation-timeline: scroll()) {
    @keyframes header-fade-out {
      to {
        opacity: 0;
      }
    }

    .header-content {
      animation: header-fade-out linear both;
      animation-timeline: scroll(root);
      animation-range: 0 5rem;
    }

    .site-header:has([aria-expanded='true']) .header-content,
    .site-header:has([role='dialog']) .header-content {
      animation: none;
    }
  }
</style>
