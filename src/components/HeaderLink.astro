---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'a'>

const { href, ...props } = Astro.props
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '')
const isActive = href === `/${pathname}`
---

<a
  href={href}
  class:list={[
    'group font-alt hover:text-brand-first-500 text-md text-brand-first-500 relative no-underline transition-colors',
    isActive && 'text-brand-first-500',
  ]}
  {...props}
>
  <slot />
  <span
    class="bg-brand-first-500 absolute bottom-0 left-0 h-[1px] w-0 transition-all duration-600 group-hover:w-full"
  ></span>
</a>
