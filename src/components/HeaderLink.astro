---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'a'>

const { href, class: className, ...props } = Astro.props
---

<a
  href={href}
  class:list={['group font-alt text-md relative text-inherit no-underline', className]}
  {...props}
>
  <slot />
  <span
    class="absolute bottom-0 left-0 h-[1px] w-0 bg-current transition-all duration-600 group-hover:w-full"
  ></span>
</a>
