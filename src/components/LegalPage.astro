---
import { getEntry } from 'astro:content'

import Markdown from '@/components/Markdown.astro'
import PrintSheet from '@/components/PrintSheet.astro'
import Layout from '@/layouts/Layout.astro'
import { tp } from '@/utils/tp'

type Props = {
  slug: string
}

const { slug } = Astro.props

const entry = await getEntry('page', slug)

if (!entry) {
  return
}

const { data: page, body } = entry

const validFrom = page.validFrom?.toLocaleDateString('cs-CZ', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
---

<Layout siteTitle={page.title} siteDescription={tp(page.title)}>
  <PrintSheet edge="only" regs={['r']}>
    <div class="px-[0.9rem] py-[2.2rem] min-md:px-[2.6rem] min-md:py-[2.5rem]">
      <h1
        class="font-head text-[clamp(1.1rem,5vw,2.6rem)] leading-[1.1] font-extrabold tracking-[-0.02em] whitespace-nowrap text-black"
      >
        {tp(page.title)}
      </h1>
      {
        validFrom && (
          <p class="font-alt mt-2 text-[0.7rem] leading-none tracking-[0.1em] text-black uppercase">
            {`Platné od ${validFrom}`}
          </p>
        )
      }
      <div class="mt-8 max-w-2xl">
        {
          body && (
            <Markdown
              class="[&_a]:text-brand-first-800 [&_li::marker]:text-brand-first-800 text-[1rem] text-gray-900 [&_a]:underline"
              text={body}
            />
          )
        }
      </div>
    </div>
  </PrintSheet>
</Layout>
