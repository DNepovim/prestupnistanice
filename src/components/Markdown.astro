---
import { marked, parseInline } from 'marked'

import JustifiedText from '@/components/JustifiedText.astro'
import LinkPreviewScript from '@/components/LinkPreviewScript.astro'
import { getLinkPreviews } from '@/utils/getLinkPreviews'
import { html } from '@/utils/html'
import { isLinkExternal } from '@/utils/isLinkExteral'
import { tp } from '@/utils/tp'

type Props = {
  text: string
  class?: string
  showMarks?: boolean
}

const { text, class: className, showMarks = false } = Astro.props

const linkPreviews = await getLinkPreviews(text)

const NP_BASE = 'font-alt text-brand-first-700/45 text-[0.6em] select-none'

const TAB_MARK = html`<span aria-hidden="true" class="${NP_BASE} mr-2">⇥</span>`
const PILCROW_MARK = html`<span aria-hidden="true" class="${NP_BASE} ml-1.5">¶</span>`

marked.use({
  renderer: {
    heading: ({ text }) =>
      html`<h3 class="font-liga font-head mt-4 text-4xl text-gray-800">${tp(text)}</h3>`,
    strong: ({ text }) => html`<strong class="font-alt">${tp(text)}</strong>`,
    em: ({ text }) => html`<em class="font-alt">${tp(text)}</em>`,
    paragraph: ({ text }) =>
      showMarks
        ? html`<p class="mb-[0.7em] text-justify leading-[1.6] break-words hyphens-auto">
            ${TAB_MARK}${parseInline(tp(text))}${PILCROW_MARK}
          </p>`
        : html`<p class="hyphenate mb-6 text-justify indent-12 break-words hyphens-auto">
            ${parseInline(tp(text))}
          </p>`,
    list(token) {
      const tag = token.ordered ? 'ol' : 'ul'
      const marker = token.ordered ? 'list-decimal' : 'list-disc'
      const items = token.items.map((item) => this.listitem(item)).join('')
      return html`<${tag} class="${marker} marker:text-brand-first-500 mb-6 pl-8 text-left leading-[1.5]">${items}</${tag}>`
    },
    listitem(item) {
      return html`<li class="mb-2 pl-1 break-words">
        ${this.parser.parse(item.tokens, item.loose)}
      </li>`
    },
    link: ({ text, href }) =>
      html`<a
        href="${href}"
        ${linkPreviews.has(href) ? `data-preview="${linkPreviews.get(href) ?? ''}"` : ''}
        target="${isLinkExternal(href) ? '_blank' : '_self'}"
        class="font-alt text-brand-first-500 hover:border-brand-second-500 border-b border-transparent"
        >${parseInline(tp(text))}</a
      >`,
    blockquote: ({ text }) =>
      html`<blockquote class="font-alt text-brand-first-500 mb-4 pl-2 text-2xl italic">
        ${tp(text)}
      </blockquote>`,
  },
})
---

<div
  set:html={marked(text)}
  class={className}
  data-justify={showMarks ? '' : undefined}
/>
{showMarks && <JustifiedText />}
<LinkPreviewScript />
