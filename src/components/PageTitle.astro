---
type Props = {
  variant?: 'default' | 'book'
}

const TITLE_VARIANTS = {
  default: 'text-gray-800 max-md:text-[10vw]',
  book: 'text-gray-600 max-md:text-[12vw]',
} as const satisfies Record<NonNullable<Props['variant']>, string>

const { variant = 'default' } = Astro.props
---

<h1
  class:list={[
    'font-liga font-head hyphenate selection:bg-brand-first-100! relative mx-auto mt-6 mb-6 inline-block max-w-full font-bold break-words min-md:text-8xl',
    TITLE_VARIANTS[variant],
  ]}
>
  <div class="relative z-10"><slot /></div>
  <span
    class="animate-width-expand from-brand-second-100 absolute bottom-0 left-0 h-[4px] w-[60%] bg-gradient-to-r to-transparent transition-all duration-600"
  ></span>
</h1>
