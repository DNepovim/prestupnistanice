---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { isDefined } from 'narrowland'

import { routes } from '@/routes'
import { getColorScale } from '@/utils/geColorScale'
import { tp } from '@/utils/tp'

import AuthorSmall from './AuthorSmall.astro'

type Props = {
  books: CollectionEntry<'book'>[]
}

const { books } = Astro.props

const bookColorScales = books.map((book) => ({
  ...getColorScale(book.data.color ?? '#434991', 'color-first'),
  ...getColorScale(book.data.bgColor ?? '#e7d14c', 'color-second'),
}))
---

<div
  class="promoted-carousel [--slide-w:min(calc(100%-96px),70rem)]"
  data-carousel
  data-color-scales={JSON.stringify(bookColorScales)}
>
  <div class="relative mt-8">
    <div class="overflow-hidden" data-carousel-viewport>
      <div class="flex gap-4 px-4 touch-pan-y">
        {
          books.map((book, index) => (
            <a
              class="promoted-slide relative block min-w-0 flex-[0_0_var(--slide-w)] transition-opacity duration-500"
              data-carousel-slide
              data-index={index}
              href={routes.books.detail(book.data.slug)}
            >
              <div class="relative">
                <h2 class="sr-only">{book.data.title}</h2>
                {isDefined(book.data.claim) && (
                  <div class="font-alt absolute right-0 bottom-0 z-10 m-4 sm:max-w-1/2 text-right sm:text-xl text-md text-white italic">
                    <span class="rounded bg-black/50 box-decoration-clone px-2 py-0.5 leading-relaxed">
                      {tp(book.data.claim.replace(/[*>#]/g, ''))}
                    </span>
                  </div>
                )}
                <Image
                  alt={book.data.title}
                  title={book.data.title}
                  src={book.data.cover}
                  width={300}
                  height={300}
                  class="aspect-square w-full rounded-md border border-gray-200 shadow-2xl sm:hidden"
                  fit="cover"
                />
                {book.data.coverTop && (
                  <Image
                    alt={book.data.title}
                    title={book.data.title}
                    src={book.data.coverTop}
                    widths={[1675, 1338]}
                    width={1338}
                    height={1420}
                    class="hidden w-full rounded-md border border-gray-200 shadow-2xl sm:block"
                  />
                )}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div
    class="relative mx-auto mt-4 mb-40 flex w-(--slide-w) items-start justify-between gap-4"
  >
    <div class="flex shrink-0 gap-2 max-sm:hidden">
      {
        books.map((book, index) => (
          <button
            type="button"
            class="promoted-step size-10 cursor-pointer overflow-hidden rounded-sm opacity-30 transition-opacity duration-500"
            data-carousel-step
            data-index={index}
            aria-label={book.data.title}
            title={book.data.title}
          >
            <Image
              src={book.data.cover}
              alt={book.data.title}
              width={40}
              height={40}
              class="size-full object-cover"
            />
          </button>
        ))
      }
    </div>
    <div class="grid grow">
      {
        books.map((book, index) => (
          <div
            class="promoted-authors [grid-area:1/1] flex flex-wrap gap-4 opacity-0 transition-opacity duration-500 min-sm:justify-end pointer-events-none"
            data-carousel-authors
            data-index={index}
          >
            {book.data.authors
              .filter((a) => a.isMain)
              .map((a) => (
                <AuthorSmall slug={a.slug.id} roles={a.role} />
              ))}
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .promoted-slide {
    opacity: 0.3;
  }
  .promoted-slide.is-snapped {
    opacity: 1;
  }
  .promoted-step.is-active {
    opacity: 1;
  }
  .promoted-authors.is-active {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  import EmblaCarousel from 'embla-carousel'
  import ClassNames from 'embla-carousel-class-names'

  const instances = new WeakMap<HTMLElement, ReturnType<typeof EmblaCarousel>>()

  function setupCarousel(root: HTMLElement) {
    const viewport = root.querySelector<HTMLElement>('[data-carousel-viewport]')
    if (!viewport || instances.has(viewport)) return

    const colorScales: Record<string, string>[] = (() => {
      try {
        return JSON.parse(root.dataset.colorScales ?? '[]')
      } catch {
        return []
      }
    })()

    const steps = [...root.querySelectorAll<HTMLElement>('[data-carousel-step]')]
    const authors = [...root.querySelectorAll<HTMLElement>('[data-carousel-authors]')]
    const slides = [...root.querySelectorAll<HTMLAnchorElement>('[data-carousel-slide]')]

    const embla = EmblaCarousel(
      viewport,
      { loop: true, align: 'center', skipSnaps: false },
      [ClassNames({ snapped: 'is-snapped' })],
    )
    instances.set(viewport, embla)

    const onSelect = () => {
      const i = embla.selectedScrollSnap()
      for (let s = 0; s < steps.length; s++) {
        steps[s].classList.toggle('is-active', s === i)
      }
      for (let a = 0; a < authors.length; a++) {
        authors[a].classList.toggle('is-active', a === i)
      }
      const scale = colorScales[i]
      if (scale) {
        for (const key in scale) {
          root.style.setProperty(`--${key}`, scale[key])
        }
      }
    }

    embla.on('select', onSelect)
    embla.on('reInit', onSelect)
    onSelect()

    steps.forEach((btn, i) => {
      btn.addEventListener('click', () => embla.scrollTo(i))
    })

    slides.forEach((slide, i) => {
      slide.addEventListener('click', (e) => {
        if (i !== embla.selectedScrollSnap()) {
          e.preventDefault()
          embla.scrollTo(i)
        }
      })
    })
  }

  function teardownAll() {
    document
      .querySelectorAll<HTMLElement>('[data-carousel] [data-carousel-viewport]')
      .forEach((vp) => {
        instances.get(vp)?.destroy()
        instances.delete(vp)
      })
  }

  function setupAll() {
    document
      .querySelectorAll<HTMLElement>('[data-carousel]')
      .forEach(setupCarousel)
  }

  document.addEventListener('astro:page-load', setupAll)
  document.addEventListener('astro:before-swap', teardownAll)
</script>
