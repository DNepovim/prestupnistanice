---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { isDefined } from 'narrowland'

import { routes } from '@/routes'
import { getColorScale } from '@/utils/geColorScale'
import { tp } from '@/utils/tp'

import AuthorSmall from './AuthorSmall.astro'

type Props = {
  books: CollectionEntry<'book'>[]
}

const { books } = Astro.props

const bookColorScales = books.map((book) => ({
  ...getColorScale(book.data.color ?? '#434991', 'color-first'),
  ...getColorScale(book.data.bgColor ?? '#e7d14c', 'color-second'),
}))
---

<div
  class="promoted-carousel [--slide-spacing:1rem] [--slide-size:min(calc(100%-2rem),70rem)] sm:[--slide-size:min(calc(100%-5rem),70rem)]"
  data-carousel
  data-color-scales={JSON.stringify(bookColorScales)}
>
  <div class="relative mt-8">
    <div class="overflow-hidden" data-carousel-viewport>
      <div class="flex touch-pan-y touch-pinch-zoom items-start">
        {
          books.map((book, index) => {
            const cleanClaim = isDefined(book.data.claim)
              ? tp(book.data.claim.replace(/[*>#]/g, ''))
              : null
            return (
              <div
                class="relative min-w-0 flex-[0_0_var(--slide-size)] px-[calc(var(--slide-spacing)/2)] opacity-30 transition-opacity duration-500 [&.is-snapped]:opacity-100"
                data-carousel-slide
                data-index={index}
              >
                <a
                  class="relative block"
                  data-carousel-cover
                  href={routes.books.detail(book.data.slug)}
                >
                  <h2 class="sr-only">{book.data.title}</h2>
                  {cleanClaim && (
                    <div class="font-alt absolute right-0 bottom-0 z-10 m-4 max-w-1/2 text-right text-xl text-white italic hidden sm:block">
                      <span class="rounded bg-black/50 box-decoration-clone px-2 py-0.5 leading-relaxed">
                        {cleanClaim}
                      </span>
                    </div>
                  )}
                  <Image
                    alt={book.data.title}
                    title={book.data.title}
                    src={book.data.cover}
                    width={300}
                    height={300}
                    class="aspect-square w-full rounded-md border border-gray-200 shadow-2xl sm:hidden"
                    fit="cover"
                  />
                  {book.data.coverTop && (
                    <Image
                      alt={book.data.title}
                      title={book.data.title}
                      src={book.data.coverTop}
                      widths={[1675, 1338]}
                      width={1338}
                      height={1420}
                      class="hidden w-full rounded-md border border-gray-200 shadow-2xl sm:block"
                    />
                  )}
                </a>
              </div>
            )
          })
        }
      </div>
    </div>
  </div>
  <div class="mt-6 grid px-4 sm:hidden">
    {
      books.map((book, index) => {
        const mainAuthors = book.data.authors.filter((a) => a.isMain)
        const cleanClaim = isDefined(book.data.claim)
          ? tp(book.data.claim.replace(/[*>#]/g, ''))
          : null
        return (
          <div
            class="pointer-events-none [grid-area:1/1] flex flex-col gap-4 opacity-0 transition-opacity duration-500 [&.is-active]:pointer-events-auto [&.is-active]:opacity-100"
            data-carousel-sync
            data-index={index}
          >
            {cleanClaim && (
              <p class="font-alt text-base text-gray-700 italic leading-relaxed">
                {cleanClaim}
              </p>
            )}
            {mainAuthors.length > 0 && (
              <div class="flex flex-wrap gap-2 -ml-4">
                {mainAuthors.map((a) => (
                  <AuthorSmall slug={a.slug.id} roles={a.role} />
                ))}
              </div>
            )}
          </div>
        )
      })
    }
  </div>
  <div
    class="relative mt-4 mb-40 hidden items-start justify-between gap-4 px-[calc((100%-var(--slide-size))/2)] sm:flex"
  >
    <div class="flex shrink-0 gap-2 pl-4">
      {
        books.map((book, index) => (
          <button
            type="button"
            class="size-10 cursor-pointer overflow-hidden rounded-md opacity-30 transition-opacity duration-500 [&.is-active]:opacity-100"
            data-carousel-step
            data-carousel-sync
            data-index={index}
            aria-label={book.data.title}
            title={book.data.title}
          >
            <Image
              src={book.data.cover}
              alt={book.data.title}
              width={40}
              height={40}
              class="size-full object-cover"
            />
          </button>
        ))
      }
    </div>
    <div class="grid grow">
      {
        books.map((book, index) => (
          <div
            class="[grid-area:1/1] flex flex-wrap gap-4 opacity-0 transition-opacity duration-500 min-sm:justify-end pointer-events-none [&.is-active]:opacity-100 [&.is-active]:pointer-events-auto"
            data-carousel-sync
            data-index={index}
          >
            {book.data.authors
              .filter((a) => a.isMain)
              .map((a) => (
                <AuthorSmall slug={a.slug.id} roles={a.role} />
              ))}
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  import EmblaCarousel from 'embla-carousel'
  import ClassNames from 'embla-carousel-class-names'

  const instances = new WeakMap<HTMLElement, ReturnType<typeof EmblaCarousel>>()

  const isColorScale = (value: unknown): value is Record<string, string> =>
    typeof value === 'object' &&
    value !== null &&
    Object.values(value).every((entry) => typeof entry === 'string')

  const parseColorScales = (raw: string): Record<string, string>[] => {
    const parsed: unknown = JSON.parse(raw)
    return Array.isArray(parsed) ? parsed.filter(isColorScale) : []
  }

  function setupCarousel(root: HTMLElement) {
    const viewport = root.querySelector<HTMLElement>('[data-carousel-viewport]')
    if (!viewport || instances.has(viewport)) return

    const colorScales = parseColorScales(root.dataset.colorScales ?? '[]')
    const synced = [...root.querySelectorAll<HTMLElement>('[data-carousel-sync]')]
    const covers = [...root.querySelectorAll<HTMLAnchorElement>('[data-carousel-cover]')]

    const embla = EmblaCarousel(viewport, { loop: true, align: 'center' }, [ClassNames()])
    instances.set(viewport, embla)

    const onSelect = () => {
      const selected = embla.selectedScrollSnap()

      synced.forEach((el) => {
        el.classList.toggle('is-active', Number(el.dataset.index) === selected)
      })

      Object.entries(colorScales[selected] ?? {}).forEach(([key, value]) => {
        root.style.setProperty(`--${key}`, value)
      })
    }

    embla.on('select', onSelect).on('reInit', onSelect)
    onSelect()

    covers.forEach((link, index) => {
      link.addEventListener('click', (event) => {
        if (index !== embla.selectedScrollSnap()) {
          event.preventDefault()
          embla.scrollTo(index)
        }
      })
    })

    root.querySelectorAll<HTMLElement>('[data-carousel-step]').forEach((btn) => {
      btn.addEventListener('click', () => embla.scrollTo(Number(btn.dataset.index)))
    })
  }

  function teardownAll() {
    document
      .querySelectorAll<HTMLElement>('[data-carousel] [data-carousel-viewport]')
      .forEach((vp) => {
        instances.get(vp)?.destroy()
        instances.delete(vp)
      })
  }

  function setupAll() {
    document
      .querySelectorAll<HTMLElement>('[data-carousel]')
      .forEach(setupCarousel)
  }

  document.addEventListener('astro:page-load', setupAll)
  document.addEventListener('astro:before-swap', teardownAll)
</script>
