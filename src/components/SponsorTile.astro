---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { HTMLAttributes } from 'astro/types'

type Props = {
  title: string
  tone: 'first' | 'second'
  link?: string
  logo?: ImageMetadata
  prefix?: string
  color?: string
  pantone?: string
  plain?: boolean
  monogram?: string
  class?: HTMLAttributes<'div'>['class']
}

const TONE_CLASSES = {
  first: 'bg-brand-first-100 group-hover:bg-brand-first-200',
  second: 'bg-brand-second-100 group-hover:bg-brand-second-200',
} as const satisfies Record<Props['tone'], string>

const { title, tone, link, logo, prefix, color, pantone, plain, monogram, class: className } = Astro.props

const Tag = link ? 'a' : 'div'
const linkProps = link ? { href: link, target: '_blank', rel: 'noopener noreferrer' } : {}
const toLinear = (channel: number) => {
  const value = channel / 255
  return value <= 0.04045 ? value / 12.92 : ((value + 0.055) / 1.055) ** 2.4
}

const getLuminance = (hex: string) => {
  const [r = 0, g = 0, b = 0] = [1, 3, 5].map((start) =>
    toLinear(parseInt(hex.slice(start, start + 2), 16)),
  )
  return 0.2126 * r + 0.7152 * g + 0.0722 * b
}

const isLightColor = color !== undefined && getLuminance(color) > 0.4

const swatchCode = [pantone ? `Pantone ${pantone}` : undefined, color?.toUpperCase()]
  .filter((part) => part !== undefined)
  .join(' · ')
---

<Tag
  {...linkProps}
  class:list={[
    'group block bg-white',
    className,
  ]}
>
  <span
    style={color && !plain ? `background-color:${color}` : undefined}
    class:list={[
      'flex h-24 items-center justify-center px-4 transition-[background-color,filter] duration-500 motion-reduce:transition-none',
      plain && 'bg-white',
      !plain && color && 'group-hover:brightness-90',
      !plain && !color && TONE_CLASSES[tone],
    ]}
  >
    {
      logo ? (
        <Image
          alt=""
          src={logo}
          width={150}
          height={100}
          widths={[300, 150]}
          class:list={[
            'max-h-16 w-auto max-w-full object-contain',
            color && !plain && !isLightColor && 'brightness-0 invert',
            (!color || plain) && 'mix-blend-multiply',
          ]}
        />
      ) : monogram ? (
        <svg
          aria-hidden="true"
          viewBox="0 0 64 64"
          fill="none"
          stroke="currentColor"
          class="text-brand-first-700 size-[4.5rem]"
        >
          <circle cx="32" cy="32" r="22" stroke-width="1.2" />
          <circle cx="32" cy="32" r="29" stroke-width="0.6" />
          <path d="M0 32H12M52 32H64M32 0V12M32 52V64" stroke-width="0.8" />
          <text
            x="32"
            y="43"
            text-anchor="middle"
            fill="currentColor"
            stroke="none"
            class="font-head"
            font-size="32"
            font-weight="800"
          >
            {monogram}
          </text>
        </svg>
      ) : (
        <span class="font-head text-brand-first-700 text-center text-[1.5rem] leading-none font-extrabold">
          {prefix && (
            <span class="font-alt mb-1 block text-[0.7rem] leading-none font-medium tracking-[0.1em] uppercase">
              {prefix}
            </span>
          )}
          {title}
        </span>
      )
    }
  </span>
  <span class="block px-3 pt-2 pb-3">
    <span class="font-alt block text-[0.8rem] leading-[1.25] font-semibold text-gray-800">
      {prefix ? `${prefix} ${title}` : title}
      {link && <span class="sr-only">(otevře se v novém okně)</span>}
    </span>
    {
      swatchCode && (
        <span
          aria-hidden="true"
          class="font-alt text-brand-first-700/70 mt-1.5 block text-[0.55rem] leading-none tracking-[0.08em] uppercase [font-variant-numeric:lining-nums]"
        >
          {swatchCode}
        </span>
      )
    }
  </span>
</Tag>
