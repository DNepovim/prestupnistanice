---
import { FALLBACK_COLOR_FIRST, FALLBACK_COLOR_SECOND } from '@/consts'
import { getColorScale } from '@/utils/geColorScale'

type Props = {
  firstColor?: string
  secondColor?: string
  keepHue?: boolean
}

const { firstColor, secondColor, keepHue = false } = Astro.props

const firstColorWithFallback = firstColor ?? FALLBACK_COLOR_FIRST
const secondColorWithFallback = secondColor ?? FALLBACK_COLOR_SECOND

const colorBrandFirstScale = getColorScale(firstColorWithFallback, 'color-brand-first', keepHue)
const colorBrandSecondScale = getColorScale(secondColorWithFallback, 'color-brand-second', keepHue)
---

{
  firstColor || secondColor ? (
    <div
      style={
        Object.entries({
          ...colorBrandFirstScale,
          ...colorBrandSecondScale,
        })
          .map(([key, value]) => `--${key}: ${value}`)
          .join(';') + ';'
      }
    >
      <slot />
    </div>
  ) : (
    <slot />
  )
}
