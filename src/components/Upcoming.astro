---
import type { CollectionEntry } from 'astro:content'
import { Icon } from 'astro-icon/components'
import { isNonEmptyArray } from 'narrowland'

import BookSheet from '@/components/BookSheet.astro'
import EventCard from '@/components/EventCard.astro'
import { getSheetEdge } from '@/utils/getSheetEdge'

type Props = {
  books: CollectionEntry<'book'>[]
  events: CollectionEntry<'event'>[]
  class?: string
}

const { books, events, class: className } = Astro.props

if (!isNonEmptyArray(books) && !isNonEmptyArray(events)) {
  return
}
---

<section
  class:list={[
    className,
    'border-brand-first-200 bg-brand-first-100/50 mb-12 border-y py-14',
  ]}
  aria-labelledby="pripravujeme"
>
  <div class="mx-auto max-w-[56rem] px-6">
    <h2
      id="pripravujeme"
      class="font-liga font-head relative mb-12 inline-block font-bold text-gray-800 max-md:text-[9vw] min-md:text-5xl"
    >
      Připravujeme
      <span
        class="animate-width-expand from-brand-first-400 absolute bottom-0 left-0 h-[3px] w-[60%] bg-gradient-to-r to-transparent"
      ></span>
    </h2>
  </div>

  {
    books.map((book, index) => (
      <BookSheet book={book} edge={getSheetEdge(index, books.length)} />
    ))
  }

  {
    isNonEmptyArray(events) && (
      <div class="mx-auto max-w-[56rem] px-6">
        <div class="border-brand-first-200 mt-16 border-t pt-10">
          <h3 class="font-alt mb-6 flex items-center gap-2 text-xs tracking-[0.2em] text-gray-800 uppercase">
            <Icon name="ph:tilde-thin" class="size-4" aria-hidden="true" />
            chystané akce
          </h3>
          <div class="grid gap-6 min-md:grid-cols-2">
            {events.map((event) => (
              <EventCard slug={event.data.slug} />
            ))}
          </div>
        </div>
      </div>
    )
  }
</section>
