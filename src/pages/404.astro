---
import { getCollection } from 'astro:content'
import { isOneOf } from 'narrowland'

import Book from '@/components/Book.astro'
import BooksContactSheet from '@/components/BooksContactSheet.astro'
import BooksGrid from '@/components/BooksGrid.astro'
import PrintSheet from '@/components/PrintSheet.astro'
import ProofGame from '@/components/ProofGame.svelte'
import Section from '@/components/Section.astro'
import Theme from '@/components/Theme.astro'
import Layout from '@/layouts/Layout.astro'
import { tp } from '@/utils/tp'
import {
  uppercaseEveryFirstLetters,
  uppercaseFirstLetter,
} from '@/utils/uppercaseFirstLetter'

const req = Astro.request
const url = new URL(req.url)
const segments = url.pathname.split('/').filter(Boolean)

const books = await getCollection('book')
const recentBooks = books.toReversed().slice(0, 9)

const category = segments[0]
const slug = segments[1]

const isBookOrAuthor = slug !== undefined && isOneOf(category, ['knihy', 'autori'])
const otherBooksLabel = tp('Ale vydali jsme řadu jiných knih:')
const browseBooksLabel = tp('Prohlédněte si naše knihy')
const proofBook = books.find((book) => book.data.slug === 'balkovsky-pegas')?.data
---

<Layout siteDescription="Zde nic není...">
  {
    isBookOrAuthor ? (
      <>
        <Section>
          <h1 class="font-alt mb-40 pt-20 text-4xl text-gray-800">
            {category === 'knihy' ? (
              <>
                Knihu{' '}
                <span class="font-liga font-head my-4 block text-7xl text-gray-800">
                  {uppercaseFirstLetter(slug.replace(/-/g, ' '))}
                </span>{' '}
                jsme zatím nevydali.
              </>
            ) : (
              <>
                Od autora{' '}
                <span class="font-liga font-head my-4 block text-7xl text-gray-800">
                  {uppercaseEveryFirstLetters(slug.replace(/-/g, ' '))}
                </span>{' '}
                jsme zatím nic nevydali
              </>
            )}
          </h1>
          <p class="font-alt text-xl">{otherBooksLabel}</p>
        </Section>
        <Section isWide>
          <BooksGrid>
            {recentBooks.map((book) => (
              <Book slug={book.data.slug} />
            ))}
          </BooksGrid>
        </Section>
      </>
    ) : (
      <>
        <Section>
          <h1 class="font-head mt-12 mb-6 text-[clamp(1.6rem,7.2vw,3.75rem)] leading-[1.08] font-extrabold tracking-[-0.015em] text-gray-800">
            <span class="block whitespace-nowrap">{tp('Stránku, kterou hledáte,')}</span>
            <span class="block whitespace-nowrap">{tp('jsme ještě nevydali.')}</span>
          </h1>
          <p class="font-alt max-w-[30.7rem] text-[1.05rem] leading-[1.45] font-medium text-gray-700">
            {tp('Pomozte našemu sazeči. Označte místa, kde udělal chybu.')}
          </p>
        </Section>
        <Section isFull>
          <Theme
            firstColor={proofBook?.color ?? undefined}
            secondColor={proofBook?.bgColor ?? undefined}
            keepHue
          >
            <ProofGame client:visible />
          </Theme>
        </Section>
        <PrintSheet edge="only" regs={['b']}>
          <div class="px-[0.9rem] py-8 min-md:px-[2.6rem]">
            <h2 class="font-head mb-7 text-[1.9rem] leading-[1.1] font-extrabold text-balance">
              {browseBooksLabel}
            </h2>
            <BooksContactSheet books={recentBooks} />
          </div>
        </PrintSheet>
      </>
    )
  }
</Layout>
