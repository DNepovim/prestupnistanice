---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { getCollection, getEntry } from 'astro:content'
import { isDefined, isNonEmptyString } from 'narrowland'

import BooksContactSheet from '@/components/BooksContactSheet.astro'
import CmykBar from '@/components/CmykBar.astro'
import Colophon from '@/components/Colophon.astro'
import ColorBar from '@/components/ColorBar.astro'
import Markdown from '@/components/Markdown.astro'
import PrintSheet from '@/components/PrintSheet.astro'
import { FALLBACK_COLOR_FIRST, FALLBACK_COLOR_SECOND } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAuthorsSecondName } from '@/utils/getAuthorSecondName'
import { getSlugFromPath } from '@/utils/getSlugFromPath'
import { pluralize } from '@/utils/pluralize'
import { ROLE_ORDER, rolesMap } from '@/utils/rolesMap'
import { getTitleFit } from '@/utils/titleFit'
import { tp } from '@/utils/tp'

// eslint-disable-next-line no-restricted-imports
import { client } from '../../../tina/__generated__/client.ts'

type Gender = CollectionEntry<'author'>['data']['gender']

const BORN_LABELS = {
  male: 'Narozen',
  female: 'Narozena',
} as const satisfies Record<Gender, string>

const DIED_LABELS = {
  male: 'Zemřel',
  female: 'Zemřela',
} as const satisfies Record<Gender, string>

const NON_PRINTING_MARK =
  'font-alt text-brand-first-700/45 align-baseline font-normal select-none'

const formatDate = (date: Date) =>
  date.toLocaleDateString('cs-CZ', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  })

export async function getStaticPaths() {
  const authors = await getCollection('author')

  return authors.map((a) => ({
    params: { slug: a.id },
    props: {
      post: a,
      getTinaProps: async () =>
        client.queries.authors({
          relativePath: a.data.slug,
        }),
    },
  }))
}

const { slug } = Astro.params

if (!slug) {
  return
}

const entry = await getEntry('author', slug)

if (!entry) {
  return
}

const { data: author } = entry

const books = await getCollection('book', ({ data }) =>
  data.authors.some(({ isMain, author }) => isMain && getSlugFromPath(author) === slug),
)

const allBooks = await getCollection('book')

const roleRows = ROLE_ORDER.flatMap((role) => {
  const label = rolesMap[role]?.perfect[author.gender]
  const count = allBooks.filter((book) =>
    book.data.authors.some(
      (a) => getSlugFromPath(a.author) === slug && a.role.includes(role),
    ),
  ).length
  return label && count > 0
    ? [{ label, value: pluralize(count, ['knihu', 'knihy', 'knih']) }]
    : []
})

const fullName = `${author.firstname} ${author.surname}`
const titleFit = getTitleFit(tp(fullName))

const newestBook = books.toSorted((a, b) => b.data.order - a.data.order)[0]
const totalPages = books.reduce((sum, book) => sum + (book.data.pagesCount ?? 0), 0)

const colophonRows = [
  author.birthDate
    ? { label: BORN_LABELS[author.gender], value: formatDate(author.birthDate) }
    : undefined,
  author.deathDate
    ? { label: DIED_LABELS[author.gender], value: formatDate(author.deathDate) }
    : undefined,
].filter(isDefined)

const lifeSpan = author.birthDate
  ? author.deathDate
    ? `${formatDate(author.birthDate)} – ${formatDate(author.deathDate)}`
    : `${BORN_LABELS[author.gender]} ${formatDate(author.birthDate)}`
  : undefined

const topSlug = [fullName, lifeSpan].filter(isDefined).join(' · ')

const WROTE_LABELS = {
  male: 'napsal',
  female: 'napsala',
} as const satisfies Record<Gender, string>

const PARTICIPATED_LABELS = {
  male: { alone: 'podílel se na', otherwise: 'jinak se podílel na' },
  female: { alone: 'podílela se na', otherwise: 'jinak se podílela na' },
} as const satisfies Record<Gender, { alone: string; otherwise: string }>

const rolesPerBook = allBooks.flatMap((book) => {
  const roles = book.data.authors
    .filter((a) => getSlugFromPath(a.author) === slug)
    .flatMap((a) => a.role)
  return roles.length > 0 ? [roles] : []
})

const writtenCount = rolesPerBook.filter((roles) => roles.includes('author')).length
const participatedCount = rolesPerBook.length - writtenCount

const writtenText =
  writtenCount > 0
    ? `${WROTE_LABELS[author.gender]} ${pluralize(writtenCount, ['knihu', 'knihy', 'knih'])}`
    : undefined

const participatedText =
  participatedCount > 0
    ? `${PARTICIPATED_LABELS[author.gender][writtenText ? 'otherwise' : 'alone']} ${pluralize(participatedCount, ['knize', 'knihách', 'knihách'])}`
    : undefined

const sideSlug = [
  writtenText,
  participatedText,
  totalPages > 0 ? `Celkem stran ${totalPages.toLocaleString('cs-CZ')}` : undefined,
]
  .filter(isDefined)
  .join(' · ')
---

<Layout
  keepHue
  tintedHeader
  tintedBackground
  siteTitle={fullName}
  siteDescription={author.claim ?? ''}
  firstColor={books[0]?.data.color ?? undefined}
  secondColor={books[0]?.data.bgColor ?? undefined}
>
  <div class="pt-4">
    <PrintSheet
      edge={newestBook ? 'first' : 'only'}
      regs={['r']}
      slug={topSlug}
      sideSlug={sideSlug}
    >
      <div
        class:list={[
          'grid grid-cols-[minmax(0,1fr)] gap-x-[2.6rem] gap-y-8 px-[0.9rem] py-[2.2rem] min-md:px-[2.6rem] min-md:py-[2.5rem]',
          'min-md:grid-cols-[15.5rem_minmax(0,1fr)]',
        ]}
      >
        {
          (
            <aside class="flex flex-col items-start gap-4 min-md:sticky min-md:top-6 min-md:self-start">
              {author.image ? (
                <Image
                  src={author.image}
                  alt={fullName}
                  width={560}
                  loading="eager"
                  class="h-auto w-full shadow-[0_0.3rem_1.4rem_rgba(0,0,0,0.18)]"
                />
              ) : (
                <div
                  aria-hidden="true"
                  class="group/silhouette from-brand-first-100 to-brand-second-100 relative aspect-square w-full overflow-hidden bg-gradient-to-br shadow-[0_0.3rem_1.4rem_rgba(0,0,0,0.18)]"
                >
                  <svg
                    viewBox="0 0 100 100"
                    preserveAspectRatio="xMidYMax slice"
                    class="absolute inset-0 size-full"
                  >
                    <defs>
                      <g id="silhouette-bust">
                        <circle cx="50" cy="38" r="17" />
                        <path d="M14 100C14 74 31 63 50 63S86 74 86 100Z" />
                      </g>
                    </defs>
                    <use
                      href="#silhouette-bust"
                      fill="#00aeef"
                      class="-translate-x-[3.2px] -translate-y-[2.2px] mix-blend-multiply transition-transform duration-700 ease-out group-hover/silhouette:translate-x-0 group-hover/silhouette:translate-y-0 motion-reduce:transition-none"
                    />
                    <use
                      href="#silhouette-bust"
                      fill="#ec008c"
                      class="translate-x-[2.8px] -translate-y-[1.6px] mix-blend-multiply transition-transform duration-700 ease-out group-hover/silhouette:translate-x-0 group-hover/silhouette:translate-y-0 motion-reduce:transition-none"
                    />
                    <use
                      href="#silhouette-bust"
                      fill="#fff200"
                      class="translate-x-[0.6px] translate-y-[3.4px] mix-blend-multiply transition-transform duration-700 ease-out group-hover/silhouette:translate-x-0 group-hover/silhouette:translate-y-0 motion-reduce:transition-none"
                    />
                    <g
                      fill="none"
                      stroke="currentColor"
                      stroke-width="0.4"
                      class="text-brand-first-700/50 origin-center transition-transform duration-700 ease-out [transform-box:fill-box] group-hover/silhouette:rotate-90 motion-reduce:transition-none"
                    >
                      <circle cx="88" cy="12" r="4.5" />
                      <circle cx="88" cy="12" r="1.8" />
                      <path d="M81 12H95M88 5V19" />
                    </g>
                  </svg>
                </div>
              )}
              {(colophonRows.length > 0 ||
                isNonEmptyString(author.aboutRole) ||
                roleRows.length > 0) && (
                <div class="grid w-full gap-4">
                  {isNonEmptyString(author.aboutRole) && (
                    <p class="font-alt text-[0.8rem] leading-[1.35] text-gray-800 italic">
                      {tp(author.aboutRole)}
                    </p>
                  )}
                  {colophonRows.length > 0 && <Colophon rows={colophonRows} />}
                  {roleRows.length > 0 && <Colophon rows={roleRows} />}
                </div>
              )}
              <div class="mt-2 flex w-full flex-col gap-1.5">
                <ColorBar
                  variant="wave"
                  grow="up"
                  from={books[0]?.data.color ?? FALLBACK_COLOR_FIRST}
                  to={books[0]?.data.bgColor ?? FALLBACK_COLOR_SECOND}
                  class="w-full"
                />
                <CmykBar variant="wave" class="w-full [&>span]:w-auto [&>span]:flex-1" />
              </div>
            </aside>
          )
        }
        <div class="min-w-0">
          <header class="[container-type:inline-size]">
            <h1
              style={`--title-w:${titleFit.widthEm.toFixed(3)}`}
              class="font-head text-brand-first-500 [font-size:min(8rem,calc(100cqw/var(--title-w)))] leading-[1.04] font-extrabold tracking-[-0.02em]"
            >
              {
                titleFit.lines.map((line, index) => (
                  <span class="block whitespace-nowrap">
                    {line}
                    {index === titleFit.lines.length - 1 && (
                      <span
                        aria-hidden="true"
                        class:list={[NON_PRINTING_MARK, 'ml-[0.25em] text-[0.3em]']}
                      >
                        ↵
                      </span>
                    )}
                  </span>
                ))
              }
            </h1>
          </header>
          {
            author.claim && (
              <blockquote class="font-alt first-letter:text-brand-first-500 mt-[1.4rem] mb-8 text-[1rem] leading-[1.45] text-gray-800 italic first-letter:float-left first-letter:pt-[0.06em] first-letter:pr-[0.1em] first-letter:text-[3.1em] first-letter:leading-[0.82] first-letter:font-bold min-lg:text-[1.15rem]">
                {tp(author.claim)}
                <span
                  aria-hidden="true"
                  class:list={[NON_PRINTING_MARK, 'ml-1.5 text-[0.6em]']}
                >
                  ¶
                </span>
              </blockquote>
            )
          }
          {entry.body && <Markdown showMarks class="text-[1rem]" text={entry.body} />}
        </div>
      </div>
    </PrintSheet>
    {
      newestBook && (
        <PrintSheet edge="last" regs={['b']}>
          <div class="px-[0.9rem] py-8 min-md:px-[2.6rem]">
            <h2 class="font-head mb-7 text-[1.9rem] leading-[1.1] font-extrabold text-balance">
              Knihy {getAuthorsSecondName(author)}
            </h2>
            <BooksContactSheet books={books} authorSlug={slug} />
          </div>
        </PrintSheet>
      )
    }
  </div>
</Layout>

<script>
  import '@/utils/colorTint'
</script>
