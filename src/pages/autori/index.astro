---
import AuthorsIndex from '@/components/AuthorsIndex.astro'
import PageTitle from '@/components/PageTitle.astro'
import PrintSheet from '@/components/PrintSheet.astro'
import Section from '@/components/Section.astro'
import Layout from '@/layouts/Layout.astro'
import { getAuthorIndex } from '@/utils/getAuthorIndex'
import { pluralize } from '@/utils/pluralize'

const groups = await getAuthorIndex()

const entries = groups.flatMap((group) => group.entries)
const booksCount = new Set(
  entries.flatMap((entry) => entry.books.map((book) => book.slug)),
).size
---

<Layout siteTitle="Autoři" siteDescription="Naši autoři">
  <Section isWide>
    <PageTitle>Autoři</PageTitle>
  </Section>
  <PrintSheet
    edge="only"
    regs={['t', 'b']}
    slug="Autoři · jmenný rejstřík"
    sideSlug={`Jmenný rejstřík · ${pluralize(entries.length, ['autor', 'autoři', 'autorů'])} · ${pluralize(booksCount, ['kniha', 'knihy', 'knih'])}`}
  >
    <AuthorsIndex groups={groups} />
  </PrintSheet>
</Layout>
