---
import { getCollection } from 'astro:content'

import ArrowLink from '@/components/ArrowLink.astro'
import Book from '@/components/Book.astro'
import BookExcerpt from '@/components/BookExcerpt.astro'
import BooksGrid from '@/components/BooksGrid.astro'
import PromotedCarousel from '@/components/PromotedCarousel.astro'
import Section from '@/components/Section.astro'
import Theme from '@/components/Theme.astro'
import Upcoming from '@/components/Upcoming.astro'
import Layout from '@/layouts/Layout.astro'
import { routes } from '@/routes'

const books = (await getCollection('book')).toSorted(
  (a, b) => b.data.order - a.data.order,
)

const promotedBooks = books.filter((b) => b.data.isPromoted)
if (promotedBooks.length === 0 && books[0]) {
  promotedBooks.push(books[0])
}

if (promotedBooks.length === 0) {
  return
}

const upcomingBooks = books.filter((b) => b.data.isUpcoming)

const now = new Date()
const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate())

const upcomingEvents = (await getCollection('event'))
  .filter((e) => e.data.date >= startOfToday)
  .toSorted((a, b) => a.data.date.getTime() - b.data.date.getTime())

const remainingBooks = books.filter(
  (b) =>
    !promotedBooks.some((p) => p.data.slug === b.data.slug) &&
    !upcomingBooks.some((u) => u.data.slug === b.data.slug),
)

const recentBooks = remainingBooks.slice(0, 3)
const forKidsBooks = remainingBooks
  .filter((b) => b.data.category === 'forKids')
  .slice(0, 3)
const philosophyBooks = remainingBooks
  .filter(
    (b) =>
      b.data.category === 'philosophy' &&
      !recentBooks.map((b) => b.data.slug).includes(b.data.slug),
  )
  .slice(0, 3)
---

<Layout
  siteDescription="Přestupní stanice je roddinné knižní nakladatelství, které se ve své ediční činnosti soustředí na kvalitní nekomerční tituly."
>
  <h1 class="sr-only">Přestupní stanice — rodinné knižní nakladatelství</h1>

  <Section isFull>
    <PromotedCarousel books={promotedBooks} />
  </Section>

  <Upcoming books={upcomingBooks} events={upcomingEvents} />

  <Section>
    <div class="flex flex-col gap-16">
      {
        recentBooks.map(({ data: book }, index) => (
          <Theme
            firstColor={book.color ?? undefined}
            secondColor={book.bgColor ?? undefined}
          >
            <BookExcerpt
              class={index % 2 === 0 ? 'min-sm:pr-8' : 'min-sm:pl-8'}
              slug={book.slug}
            />
          </Theme>
        ))
      }
    </div>
    <div class="my-20 flex justify-center">
      <ArrowLink href={routes.books.list()}>všechny knihy</ArrowLink>
    </div>
  </Section>
  {
    forKidsBooks.length > 0 && (
      <Section title="Knihy pro děti" link={routes.books.category('forKids')}>
        <BooksGrid>
          {forKidsBooks.map((book) => (
            <Book slug={book.data.slug} />
          ))}
        </BooksGrid>
      </Section>
    )
  }
  {
    philosophyBooks.length > 0 && (
      <Section title="Knihy pro filosofy" link={routes.books.category('philosophy')}>
        <BooksGrid>
          {philosophyBooks.map((book) => (
            <Book slug={book.data.slug} />
          ))}
        </BooksGrid>
      </Section>
    )
  }
</Layout>
