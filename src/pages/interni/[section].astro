---
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'

import PageTitle from '@/components/PageTitle.astro'
import Section from '@/components/Section.astro'
import Layout from '@/layouts/Layout.astro'
import { routes } from '@/routes'
import { getBookGaps } from '@/utils/getBookGaps'

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { section: 'podklady' } }] : []
}

const galleryPaths = Object.keys(
  import.meta.glob('/src/content/images/books/*/gallery/*.{jpg,jpeg,png,webp,gif,GIF}'),
)

const countGalleryImages = (slug: string) =>
  galleryPaths.filter((path) => path.includes(`/books/${slug}/gallery/`)).length

const books = (await getCollection('book')).toSorted(
  (a, b) => b.data.order - a.data.order,
)

const rows = books.map((book) => {
  const gaps = getBookGaps(book, countGalleryImages(book.data.slug))
  return {
    book: book.data,
    gaps,
    missing: gaps.filter((gap) => gap.isApplicable && !gap.isPresent),
  }
})

const columns = rows[0]?.gaps ?? []
const imageColumnsCount = columns.filter((gap) => gap.group === 'images').length
const metadataColumnsCount = columns.length - imageColumnsCount

const completeCount = rows.filter((row) => row.missing.length === 0).length
const totalMissing = rows.reduce((sum, row) => sum + row.missing.length, 0)

const headCell = 'px-3 py-2 text-left font-head text-xs uppercase tracking-wide'
---

<Layout siteTitle="Chybějící podklady" siteDescription="Interní přehled podkladů knih">
  <Section isWide>
    <PageTitle>Chybějící podklady</PageTitle>
    <p class="text-brand-first-700 mb-8 text-center">
      {completeCount} z {rows.length} knih je kompletních, celkem chybí {totalMissing} podkladů.
    </p>
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead class="bg-brand-first-50 text-brand-first-800">
          <tr>
            <th class={headCell} rowspan="2">Kniha</th>
            <th class={headCell} colspan={imageColumnsCount}>Obrázky</th>
            <th class={headCell} colspan={metadataColumnsCount}>Metadata</th>
            <th class={headCell} rowspan="2">Chybí</th>
          </tr>
          <tr>
            {columns.map((gap) => <th class={headCell}>{gap.label}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            rows.map(({ book, gaps, missing }) => (
              <tr class="border-brand-first-100 hover:bg-brand-first-50/50 border-b">
                <td class="px-3 py-2">
                  <a
                    href={routes.books.detail(book.slug)}
                    class="font-head underline-offset-2 hover:underline"
                  >
                    {book.order}. {book.title}
                  </a>
                  {book.isUpcoming && (
                    <span class="text-brand-first-600 ml-2 text-xs">připravujeme</span>
                  )}
                </td>
                {gaps.map((gap) => (
                  <td
                    class:list={[
                      'px-3 py-2 text-center',
                      gap.isApplicable &&
                        (gap.isPresent ? 'bg-emerald-100' : 'bg-red-100'),
                    ]}
                  >
                    {!gap.isApplicable ? (
                      <span class="text-brand-first-300">—</span>
                    ) : (
                      <span
                        class:list={[
                          'inline-flex items-center gap-1',
                          gap.isPresent ? 'text-emerald-800' : 'text-red-800',
                        ]}
                        title={gap.label}
                      >
                        <Icon
                          name={gap.isPresent ? 'ph:check-circle' : 'ph:x-circle'}
                          class="size-5"
                        />
                        {gap.detail}
                      </span>
                    )}
                  </td>
                ))}
                <td class="font-head px-3 py-2 text-center">
                  {missing.length > 0 ? missing.length : '—'}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Section>
</Layout>
