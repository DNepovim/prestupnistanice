---
import { getCollection } from 'astro:content'

import GapsTable from '@/components/GapsTable.astro'
import InternalLayout from '@/layouts/InternalLayout.astro'
import { routes } from '@/routes'
import { getAuthorGaps } from '@/utils/getAuthorGaps'

const authors = await getCollection('author')

const rows = authors
  .toSorted((a, b) => a.data.surname.localeCompare(b.data.surname, 'cs'))
  .map((author) => ({
    href: routes.authors.detail(author.id),
    title: `${author.data.surname} ${author.data.firstname}`,
    gaps: getAuthorGaps(author),
  }))
---

<InternalLayout
  siteTitle="Chybějící podklady autorů"
  siteDescription="Interní přehled podkladů autorů"
>
  <GapsTable
    title="Chybějící podklady autorů"
    subject="autorů"
    rowLabel="Autor"
    rows={rows}
  />
</InternalLayout>
