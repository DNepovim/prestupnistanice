---
import type { ImageMetadata } from 'astro'
import { getCollection } from 'astro:content'

import GapsTable from '@/components/GapsTable.astro'
import InternalLayout from '@/layouts/InternalLayout.astro'
import { routes } from '@/routes'
import { getBookGaps } from '@/utils/getBookGaps'

const galleryModules = import.meta.glob<ImageMetadata>(
  '/src/content/images/books/*/gallery/*.{jpg,jpeg,png,webp,gif,GIF}',
  { eager: true, import: 'default' },
)

const getGalleryImages = (slug: string) =>
  Object.entries(galleryModules)
    .filter(([path]) => path.includes(`/books/${slug}/gallery/`))
    .map(([, image]) => image)

const books = (await getCollection('book')).toSorted(
  (a, b) => b.data.order - a.data.order,
)

const rows = books.map((book) => ({
  href: routes.books.detail(book.data.slug),
  title: `${String(book.data.order)}.${book.data.title}`,
  note: book.data.isUpcoming ? 'připravujeme' : undefined,
  gaps: getBookGaps(book, getGalleryImages(book.data.slug)),
}))
---

<InternalLayout
  siteTitle="Chybějící podklady knih"
  siteDescription="Interní přehled podkladů knih"
>
  <GapsTable
    title="Chybějící podklady knih"
    subject="knih"
    rowLabel="Kniha"
    rows={rows}
  />
</InternalLayout>
