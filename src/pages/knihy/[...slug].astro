---
import { getCollection } from 'astro:content'
import { isOneOf } from 'narrowland'

import BookDetail from '@/components/BookDetail.astro'
import BooksCategory from '@/components/BooksCategory.astro'
import { categoryKeys } from '@/routes'

export async function getStaticPaths() {
  const posts = await getCollection('book')

  return [...posts.map(({ data }) => data.slug), ...categoryKeys]
    .filter((slug) => slug !== '')
    .map((slug) => ({
      params: { slug },
    }))
}

const { slug } = Astro.params
---

{isOneOf(slug, categoryKeys) ? <BooksCategory slug={slug} /> : <BookDetail slug={slug} />}
