---
import { getCollection, getEntry } from 'astro:content'
import { isNonEmptyArray, isNonEmptyString, isOneOf } from 'narrowland'

import AuthorSmall from '@/components/AuthorSmall.astro'
import BooksGrid from '@/components/BooksGrid.astro'
import Markdown from '@/components/Markdown.astro'
import PageTitle from '@/components/PageTitle.astro'
import Section from '@/components/Section.astro'
import SponsorLogo from '@/components/SponsorLogo.astro'
import LogoFondBudoucnosti from '@/content/images/fondBudoucnosti.png'
import LogoFondKultury from '@/content/images/fondKultury.png'
import LogoGi from '@/content/images/gi.png'
import LogoKima from '@/content/images/kima.png'
import LogoMk from '@/content/images/mk.png'
import Layout from '@/layouts/Layout.astro'
import { getSlugFromPath } from '@/utils/getSlugFromPath'

const sponsors = [
  { title: 'Ministerstov kultury ČR', link: 'https://www.mk.gov.cz/', logo: LogoMk },
  {
    title: 'Goethe institut',
    link: 'https://www.goethe.de/ins/cz/cs/index.html',
    logo: LogoGi,
  },
  {
    title: 'Česko-německý fond budoucnosti',
    link: 'https://www.fondbudoucnosti.cz/',
    logo: LogoFondBudoucnosti,
  },
  {
    title: 'Státní fond kultury ČR',
    link: 'https://www.mk.gov.cz/statni-fond-kultury-cr-cs-42',
    logo: LogoFondKultury,
  },
]

const kimaSponsor = {
  title: 'Jiří Málek – KIMA Transport s. r. o.',
  link: 'https://www.kimatransport.cz/',
  logo: LogoKima,
}

const textSponsors = [{ prefix: 'manželé', name: 'Winklerovi' }]

const entry = await getEntry('page', 'o-nakladatelstvi')

if (!entry) {
  return
}

const { data: page } = entry

const books = await getCollection('book')
const authors = await getCollection('author')

const authorRolesMap = books
  .flatMap((book) => book.data.authors)
  .filter((entry) => !entry.isMain)
  .reduce<Record<string, string[]>>((acc, entry) => {
    const slug = getSlugFromPath(entry.author)
    const newRoles = entry.role
    const existing = acc[slug] ?? []

    const mergedRoles = Array.from(new Set([...existing, ...newRoles]))

    return { ...acc, [slug]: mergedRoles }
  }, {})

const boardMemberSlugs = ['jakub-skalak', 'petr-blaha', 'dominik-blaha']

const boardMembers = boardMemberSlugs.map((slug) => ({
  slug,
  description: authors.find((a) => a.data.slug === slug)?.data.aboutRole,
}))

const collaborators = authors
  .filter((a) => a.data.showOnAboutPage)
  .filter((a) => !isOneOf(a.data.slug, boardMemberSlugs))
  .map((a) => ({
    slug: a.data.slug,
    role: a.data.aboutRole,
    roles: isNonEmptyString(a.data.aboutRole) ? [] : (authorRolesMap[a.data.slug] ?? []),
  }))
---

<Layout siteTitle={page.title} siteDescription={page.content?.substring(0, 900) ?? ''}>
  <Section>
    <PageTitle>{page.title}</PageTitle>
    <div class="mx-auto mt-16 max-w-2xl leading-8">
      {entry.body && <Markdown text={entry.body} />}
    </div>
  </Section>
  <Section title="Redakční rada">
    <BooksGrid>
      {
        boardMembers.map(({ slug, description }) => (
          <AuthorSmall slug={slug} description={description} imperfect />
        ))
      }
    </BooksGrid>
  </Section>
  {
    isNonEmptyArray(collaborators) && (
      <Section title="Spolupracují s námi">
        <BooksGrid>
          {collaborators.map(({ slug, role, roles }) => (
            <AuthorSmall slug={slug} role={role} roles={roles} imperfect />
          ))}
        </BooksGrid>
      </Section>
    )
  }
  <Section title="Podporují nás">
    <div class="flex flex-wrap items-center justify-center gap-8">
      {sponsors.map((sponsor) => <SponsorLogo {...sponsor} />)}
      <div class="flex items-center gap-8">
        <SponsorLogo {...kimaSponsor} />
        {
          textSponsors.map((sponsor) => (
            <p class="font-alt text-brand-first-700 text-left leading-tight">
              <span class="block text-sm">{sponsor.prefix}</span>
              <span class="block text-lg">{sponsor.name}</span>
            </p>
          ))
        }
      </div>
    </div>
  </Section>
</Layout>
